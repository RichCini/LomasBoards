 06CB 7205	   06D2 	JC	FLAGSET
 06CD 2E8B841E00		MOV	AX,CS:30[SI]
			FLAGSET:
 06D2 0BC0			OR	AX,AX
 06D4 740B	   06E1 	JZ	NEXTFLG
 06D6 E807FC	   02E0 	CALL	OUT
 06D9 8AC4			MOV	AL,AH
 06DB E802FC	   02E0 	CALL	OUT
 06DE E80AFC	   02EB 	CALL	BLANK
			NEXTFLG:
