 0627 E89300	   06BD 	CALL	DISPFLAGS
 062A E934FC	   0261 	JMP	CRLF
			FLAG:
 062D 80FA46			CMP	DL,'F'
 0630 75D7	   0609 	JNZ	BADREG
 0632 E88800	   06BD 	CALL	DISPFLAGS
 0635 B02D			MOV	AL,'-'
 0637 E8A6FC	   02E0 	CALL	OUT
 063A E8F1FB	   022E 	CALL	INBUF
 063D E85DFC	   029D 	CALL	SCANB
 0640 33DB			XOR	BX,BX
 0642 8B16B504			MOV	DX,FSAVE
			GETFLG:
 0646 8BF7			MOV	SI,DI
 0648 AD			LODSW
 0649 3C0D			CMP	AL,13
 064B 7466	   06B3 	JZ	SAVCHG
 064D 80FC0D			CMP	AH,13
 0650 7466	   06B8 	JZ	FLGERR
 0652 BFA10A			MOV	DI,offset FLAGTAB
 0655 B92000			MOV	CX,32
 0658 0E			PUSH	CS
 0659 07			POP	ES
 065A F2AF			REPNE	SCASW
 065C 755A	   06B8 	JNZ	FLGERR
 065E 8AE9			MOV	CH,CL
 0660 80E10F			AND	CL,0FH
 0663 B80100			MOV	AX,1
 0666 D3C0			ROL	AX,CL
 0668 85C3			TEST	AX,BX
 066A 7533	   069F 	JNZ	REPFLG
 066C 0BD8			OR	BX,AX
 066E 0BD0			OR	DX,AX
 0670 F6C510			TEST	CH,16
 0673 7502	   0677 	JNZ	NEXFLG
 0675 33D0			XOR	DX,AX
			NEXFLG:
 0677 8BFE			MOV	DI,SI
 0679 1E			PUSH	DS
 067A 07			POP	ES
 067B E816FC	   0294 	CALL	SCANP
 067E EBC6	   0646 	JMPS	GETFLG
			DISPREGLINE:
 0680 2EAD			LODS	CS:AX
 0682 E85BFC	   02E0 	CALL	OUT
 0685 8AC4			MOV	AL,AH
 0687 E856FC	   02E0 	CALL	OUT
 068A B03D			MOV	AL,'='
 068C E851FC	   02E0 	CALL	OUT
 068F 8B17			MOV	DX,[BX]
 0691 43			INC	BX
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  20


 0692 43			INC	BX
 0693 E82EFC	   02C4 	CALL	OUT16
 0696 E852FC	   02EB 	CALL	BLANK
 0699 E84FFC	   02EB 	CALL	BLANK
 069C E2E2	   0680 	LOOP	DISPREGLINE
 069E C3			RET
			REPFLG:
 069F B84446			MOV	AX,4600H+'D'	;DF ERROR
