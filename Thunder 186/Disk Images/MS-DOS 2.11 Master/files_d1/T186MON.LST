			LOAD:
			;LOADS THE SPECIFIED NUMBER OF RECORDS FROM THE DISK STARTING AT
			;THE SPECIFIED RECORD. DATA IS PLACED IN MEMORY BEGINING AT THE
			;ADDRESS SPECIFIED.
 06E4 C606D00400		MOV	byte ptr DONTPRNT,FALSE ;ENABLE ERROR PRINTING
 06E9 1E			PUSH	DS		;SAVE THE OLD DATA SEGMET
 06EA E86300	   0750 	CALL	DISKSETUP	;GET ALL THE PARAMETERS
 06ED E83704	   0B27 	CALL	READ		;DO THE READ
 06F0 1F			POP	DS		;RESTORE THE DATA SEGMENT
 06F1 7306	   06F9 	JNC	RET5		;IF NO CARRY THEN NO ERROR
 06F3 BE3007			MOV	SI,offset BADREAD ;PRINT ERROR MESAGE IF THERE IS ERROR
 06F6 E9FAFD	   04F3 	JMP	PRINT
 06F9 C3		RET5:	RET

			WRITE:
			;WRITES MEMORY BEGINING AT THE SPECIFIED ADDRESS TO DISK BEGINING AT
			;THE SPECIFIED RECORD ON THE DISK. A MAXIMUM OF 64K BYTES MAY BE
			;WRITTEN.
 06FA C606D00400		MOV	byte ptr DONTPRNT,FALSE ;ENABLE ERROR PRINTING
 06FF 1E			PUSH	DS		;SAVE PRESENT DATA SEGMENT
 0700 E84D00	   0750 	CALL	DISKSETUP	;GET ALL THE PARAMETERS
 0703 E82F04	   0B35 	CALL	WRITEDSK	;DO THE WRITE
 0706 1F			POP	DS		;RESTORE THE DATA SEGMENT
 0707 73F0	   06F9 	JNC	RET5		;IF NO ERROR RETURN ELST
 0709 BE0F07			MOV	SI,offset BADWRITE ;PRINT ERROR MESSAGE
 070C E9E4FD	   04F3 	JMP	PRINT

