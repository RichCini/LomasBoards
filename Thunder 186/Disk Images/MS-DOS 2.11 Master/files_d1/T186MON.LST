 0AB5 0000                      DW      0
 0AB7 4143                      DB      'AC'
 0AB9 0000                      DW      0
 0ABB 5045                      DB      'PE'
 0ABD 0000                      DW      0
 0ABF 4359                      DB      'CY'
 0AC1 0000                      DW      0
 0AC3 0000                      DW      0
 0AC5 0000                      DW      0
 0AC7 0000                      DW      0
 0AC9 4E56                      DB      'NV'
 0ACB 5550                      DB      'UP'
 0ACD 4449                      DB      'DI'
 0ACF 0000                      DW      0
 0AD1 504C                      DB      'PL'
 0AD3 4E5A                      DB      'NZ'
 0AD5 0000                      DW      0
 0AD7 4E41                      DB      'NA'
 0AD9 0000                      DW      0
 0ADB 504F                      DB      'PO'
 0ADD 0000                      DW      0
 0ADF 4E43                      DB      'NC'

 0AE1 0D0A0A544855      HEADER  DB      13,10,10,'THUNDER 186 monitor Rev 0.10',13,10,0 
      4E4445522031
      3836206D6F6E
      69746F722052
      657620302E31
      300D0A00
 0B03 5E                SYNERR  DB      '^'
 0B04 204572726F72      ERRMES  DB      ' Error',13,10,0 
      0D0A00
 0B0D 08200800          BACMES  DB      8,32,8,0 


   0006                 READCMND        EQU     6H      ;FDC COMAND EQUATES
   0005                 WRITECMND       EQU     5H
   0007                 RECALCMND       EQU     7H
   0008                 SENSEINTCMND    EQU     8
   0004                 SENSESTATUSCMND EQU     4H
   000F                 SEEKCMND        EQU     0FH
   0040                 MFM             EQU     40H
   0009                 MAXTRIES        EQU     9       ;NUMBER OF TRIES BEFORE DISK ERROR

                        ;The following routines are for the rom diskette read write routines.

                        WRITEDSK1:
 0B11 33F6                      XOR     SI,SI
 0B13 8EC6                      MOV     ES,SI
 0B15 26C606D004FF              MOV     ES:byte ptr DONTPRNT,TRUE
 0B1B EB18         0B35         JMPS    WRITEDSK

                        READ1:
 0B1D 33F6                      XOR     SI,SI
 0B1F 8EC6                      MOV     ES,SI
 0B21 26C606D004FF              MOV     ES:byte ptr DONTPRNT,TRUE

                        READ:
                        ;THE NUMBER OF SECTORS SPECIFIED ARE TRANSFERED BETWEEN THE GIVEN
                        ;DRIVE AND THE TRANSFER ADDRESS.
                        ;
                        ;ON ENTRY:
                        ;
                        ;       AL=DRIVE NUMBER
                        ;       CX=NUMBER OF RECORDS TO TRANSFER
                        ;       DX=LOGICAL RECORD NUMBER
                        ;       DS:BX=TRANSFER ADDRESS
                        ;

 0B27 26C606B70406              MOV     ES:byte ptr CMND,READCMND
 0B2D 26C606C904FF              MOV     ES:byte ptr READFLAG,TRUE       ;INDICATE READ OPERATION
 0B33 EB0C         0B41         JMPS    COMMON                  ;GO TO THE COMMON CODE
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  28



                        WRITEDSK:
                        ;THE SAME ENTRY CONDITIONS AS READ EXCEPT DATA IS TRANSFERED
                        ;FROM MEMORY TO DISK.

 0B35 26C606B70405              MOV     ES:byte ptr CMND,WRITECMND      ;SET TO WRITE COMMAND
 0B3B 26C606C90400              MOV     ES:byte ptr READFLAG,FALSE      ;INDICATE WRITE OPERATION

                        COMMON:
 0B41 26C606C00400              MOV     ES:byte ptr RETRY,0             ;SET NUMBER OF RETRIES TO 0
                        ;       SAVE REGISTERS
                        DSKRETRY:
 0B47 50                        PUSH    AX
 0B48 53                        PUSH    BX
 0B49 51                        PUSH    CX
 0B4A 52                        PUSH    DX
 0B4B 1E                        PUSH    DS
 0B4C 06                        PUSH    ES
 0B4D 268C1EC304                MOV     ES:DMASEG,DS
 0B52 06                        PUSH    ES
 0B53 1F                        POP     DS
 0B54 891EC104                  MOV     DMAOFF,BX       ;SAVE THE OFFSET
 0B58 8AD8                      MOV     BL,AL
 0B5A B700                      MOV     BH,0H
 0B5C E4D2                      in      al,switch_port
 0B5E A808                      test    al,8h                   ;5.25 or 8" ?
 0B60 750F	   0B71 	jnz	small_drive_op
 0B62 2E8A87E30E		MOV	CS:al, byte ptr UNITTAB[BX]
 0B67 A2B804			MOV	UNIT,AL
 0B6A D1E3			SHL	BX,1
 0B6C 2EFFA7BB0E		JMP	CS:JMPTBL[BX]
			small_drive_op:
 0B71 2E8A87EB0E		MOV	CS:AL,byte ptr SD_UNITTAB[BX]
 0B76 A2B804			MOV	UNIT,AL
 0B79 D1E3			SHL	BX,1
 0B7B 2EFFA7CB0E		jmp	cs:sd_jmptbl[bx]	;do 5.25 disk operation

			COMMON1:
 0B80 E82C00	   0BAF 	CALL	EXECUTE
 0B83 721E	   0BA3 	JC	COMMON3
			;IF ERROR THEN DO
			;	IF RETRY=MAXTRIES THEN
			;		DO
			;		GET NUMBER OF REMAINING SECTORS
			;		RESTORE REGISTERS EXCEPT FOR CX
			;		SET ERROR INDICATOR
			;		RET
			;		END
 0B85 A0C004			MOV	AL,RETRY
 0B88 3C09			CMP	AL,MAXTRIES
 0B8A 7C0C	   0B98 	JL	COMMON4
 0B8C 8B0EC504			MOV	CX,RTT
 0B90 07			POP	ES
 0B91 1F			POP	DS
 0B92 5A			POP	DX
 0B93 5B			POP	BX		;DONT RESTORE CX
 0B94 5B			POP	BX
 0B95 58			POP	AX
 0B96 F9			STC			;INDICATE ERROR
 0B97 C3			RET
			;	ELSE DO
			;		SHAKE HEAD ON DRIVE
			;		TRY AGAIN
			;		END
			COMMON4:
 0B98 E84D02	   0DE8 	CALL	SHAKEHEAD
 0B9B 07			POP	ES
 0B9C 1F			POP	DS
 0B9D 5A			POP	DX
 0B9E 59			POP	CX
 0B9F 5B			POP	BX
 0BA0 58			POP	AX
 0BA1 EBA4	   0B47 	JMPS	DSKRETRY
			;ELSE DO
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  29


			;	SETUP FOR RETURN
			;	INDICATE SUCCESS
			;	RETURN
			COMMON3:
 0BA3 8B0EC504			MOV	CX,RTT		;GET NUMBER OF RECORDS LEFT SHOULD
							;BE 0 BECAUSE THIS IS THE SUCCESSFULL
							;RETURN
 0BA7 07			POP	ES
 0BA8 1F			POP	DS
 0BA9 5A			POP	DX
 0BAA 5B			POP	BX
 0BAB 5B			POP	BX		;DON'T RESTORE CX
 0BAC 58			POP	AX
 0BAD F8			CLC			;INDICATE SUCCESS
 0BAE C3			RET
			EXECUTE:
 0BAF E86B02	   0E1D 	CALL	SEEK		;SEEK SELECTED TRACK
 0BB2 BEB704			MOV	SI,offset IOPB	;POINT TO FDC COMMAND BLOCK
 0BB5 E88102	   0E39 	CALL	OUTIOPB 	;OUTPUT THE COMMAND BLOCK
 0BB8 F606C904FF	MORE:	TEST	byte ptr READFLAG,TRUE	;READ OPERATION?
 0BBD 7405	   0BC4 	JZ	WRITEEXEC	;IF NOT GO TO WRITE
 0BBF E8A700	   0C69 	CALL	INDATA		;READ SO GO BRING IN THE DATA
 0BC2 EB03	   0BC7 	JMPS	WRITEBYPASS
			WRITEEXEC:
 0BC4 E87900	   0C40 	CALL	OUTDATA
			WRITEBYPASS:
 0BC7 E304	   0BCD 	JCXZ	EXECUTE1	;DID TRANSFER OK IF CX=0
 0BC9 E82E00	   0BFA 	CALL	ERRORTERMINATE	;ELSE THERE WAS AN ERROR
 0BCC C3			RET
			EXECUTE1:
 0BCD FF0EC504			DEC	word ptr RTT	;DECREMENT SECTOR COUNT
 0BD1 7423	   0BF6 	JZ	EXECUTEDONE	;IF 0 THEN DONE
 0BD3 A0BB04			MOV	AL,SECTOR	;ELSE SEE IF END OF TRACK
 0BD6 3A06BD04			CMP	AL,EOT
 0BDA 7407	   0BE3 	JE	NEXTTRACK	;IF IT IS GO TO NEXT TRACK ROUTINE
 0BDC FEC0			INC	AL		;IF NOT INCREMENT SECTOR NUMBER
 0BDE A2BB04			MOV	SECTOR,AL	;PUT IT BACK
 0BE1 EBD5	   0BB8 	JMPS	MORE		;GET MORE DATA
			NEXTTRACK:
 0BE3 E82500	   0C0B 	CALL	NORMALTERMINATE ;STOP THE DISK OPERATION
 0BE6 7311	   0BF9 	JNC	EXECUTERETURN	;IF CARRY THEN ERROR DETECTED
 0BE8 FE06DB04			INC	byte ptr TRACK	;NEXT TRACK
 0BEC E8BF01	   0DAE 	CALL	FIXCYL		;ADJUST IF DOUBLE SIDED
 0BEF C606BB0401		MOV	byte ptr SECTOR,1 ;FIRST SECTOR
 0BF4 EBB9	   0BAF 	JMPS	EXECUTE 	;GO GET MORE DATA
			EXECUTEDONE:
 0BF6 E81200	   0C0B 	CALL	NORMALTERMINATE ;ALL DONE STOP THE DISK CONTROLLER
			EXECUTERETURN:
 0BF9 C3			RET

			ERRORTERMINATE:
 0BFA E8FB01	   0DF8 	CALL	TC		;STOP THE PRESENT COMMAND
 0BFD E88E02	   0E8E 	CALL	WTINT		;WAIT FOR THE INTERRUPT
 0C00 E80B02	   0E0E 	CALL	INRSLT		;GET THE RESULTS OF THE COMMAND
 0C03 E82000	   0C26 	CALL	PRINTERR
 0C06 E86002	   0E69 	CALL	SENSE		;CLEAR THE INTERRUPT
 0C09 F8			CLC			;SET ERROR INDICATION
 0C0A C3			RET

			NORMALTERMINATE:
 0C0B E8EA01	   0DF8 	CALL	TC		;STOP THE 8272
 0C0E E87D02	   0E8E 	CALL	WTINT		;WAIT FOR THE INTERRUPT
 0C11 E8FA01	   0E0E 	CALL	INRSLT		;GET THE RESULTS FROM THE 8272
 0C14 E8EC01	   0E03 	CALL	CHECK		;GHECK THE RESULTS FOR AN ERROR
 0C17 7305	   0C1E 	JNC	DISKERROR	;IF THE IS AN ERROR GO TO ERROR ROUTINE
 0C19 E84D02	   0E69 	CALL	SENSE		;CLEAR THE INTERRUPT
 0C1C F9			STC			;INDICATE ALL OK
 0C1D C3			RET
			DISKERROR:
 0C1E E80500	   0C26 	CALL	PRINTERR
 0C21 E84502	   0E69 	CALL	SENSE		;CLEAR THE INTERRUPT
 0C24 F8			CLC			;INDICATE FAILURE
 0C25 C3		RET6:	RET

CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  30


			PRINTERR:
			;PRINTS THE STATUS FRMOMTHE FDC AFTER AN ERROR
 0C26 F606D004FF		TEST	byte ptr DONTPRNT,TRUE ;DONT PRINT IF DISABLED
 0C2B 75F8	   0C25 	JNZ	RET6
 0C2D BED104			MOV	SI,offset RSLTS
 0C30 B90700			MOV	CX,7		;7 BYTES TO PRINT
				
			PNTERRLOOP:
 0C33 AC			LODSB			;GET THE BYTE
 0C34 E894F6	   02CB 	CALL	HEX		;PRINT IT
 0C37 E8B1F6	   02EB 	CALL	BLANK		;SPACE
 0C3A E2F7	   0C33 	LOOP	PNTERRLOOP	;DO UNTILL ALL 7 PRINTED
 0C3C E822F6	   0261 	CALL	CRLF		;NEW LINE
 0C3F C3			RET

			OUTDATA:
 0C40 FC			CLD			;SET TO INCREMENTING MOVE
 0C41 8B36C104			MOV	SI,DMAOFF	;GET THE OFFSET OF THE DMA BUFFER
 0C45 8B0ECA04			MOV	CX,TRANSFER	;GET THE NUMBER OF BYTES TO WRITE
 0C49 1E			PUSH	DS		;SAVE THE PRESENT SEGMENT
 0C4A 8E1EC304			MOV	DS,DMASEG	;GET THE DMA SEGMENT
 0C4E BA9200			MOV	DX,FDC_DATA	;GET A POINTER TO THE 8272 DMA PORT
 0C51 B480			MOV	AH,80H		;GET TEST BYTE FOR INTERRUPT TEST
 0C53 B320			MOV	BL,020H 	;TEST BYTE FOR EXECUTION PHASE
			OUTDATA1:
 0C55 E490			IN	AL,FDC_STATUS	;WAIT FOR RQM
 0C57 84C4			TEST	AL,AH
 0C59 74FA	   0C55 	JZ	OUTDATA1
 0C5B 84C3			TEST	AL,BL		;STILL IN EXECUTION PHASE?
 0C5D 7404	   0C63 	JZ	OUTDATA2	;IF 0 THEN EXECUTION PHASE IS DONE(PROBABLE
							;ERROR)
 0C5F AC			LODSB			;GET BYTE FROM THE DMA BUFFER
 0C60 EE			OUT	DX,AL		;WRITE IT TO THE 8272
 0C61 E2F2	   0C55 	LOOP	OUTDATA1	;IF NOT ALL DONE(CX=0) DO AGAIN
			OUTDATA2:
 0C63 1F			POP	DS		;RESTORE THE OLD DATA SEGMENT
 0C64 8936C104			MOV	DMAOFF,SI	;SAVE THE NEW BUFFER OFFSET VALUE
 0C68 C3			RET

			INDATA:
 0C69 FC			CLD			;SET TO INCREMENTING MOVE
 0C6A 8B3EC104			MOV	DI,DMAOFF	;GET BUFFER OFFSET POINTER
 0C6E 8B0ECA04			MOV	CX,TRANSFER	;GET NUMBER OF BYTES TO READ
 0C72 06			PUSH	ES		;SAVE THE PRESENT EXTRA SEGMENT
 0C73 8E06C304			MOV	ES,DMASEG	;GET DMA SEGMENT
 0C77 BA9200			MOV	DX,FDC_DATA	;POINTER TO 8272 DMA PORT
 0C7A B480			MOV	AH,80H		;GET BYTE TO USE IN RQM TEST
 0C7C B320			MOV	BL,020H 	;TEST BYTE FOR EXECUTION PHASE
			INDATA1:
 0C7E E490			IN	AL,FDC_STATUS	;WAIT FOR RQM
 0C80 84C4			TEST	AL,AH
 0C82 74FA	   0C7E 	JZ	INDATA1
 0C84 84C3			TEST	AL,BL		;STILL IN EXECUTION PHASE?
 0C86 7404	   0C8C 	JZ	INDATA2 	;IF NOT THEN QUIT (PROBABLE ERROR)
 0C88 EC			IN	AL,DX		;GET THE BYTE FROM THE 8272
 0C89 AA			STOSB			;PUT IT IN THE BUFFER
 0C8A E2F2	   0C7E 	LOOP	INDATA1 	;DO UNTIL CX=0
			INDATA2:
 0C8C 07			POP	ES		;RESTORE THE OLD ES
 0C8D 893EC104			MOV	DMAOFF,DI	;SAVE NEW DMA BUFFER OFFSET
 0C91 C3			RET

			SDSETUP:
 0C92 C606DC0400		MOV	byte ptr DBLSDD,FALSE
 0C97 8BC2			MOV	AX,DX			;COMPUTE THE TRACK AND SECTOR
 0C99 B21A			MOV	DL,26
 0C9B F6F2			DIV	DL
 0C9D A2DB04			MOV	byte ptr TRACK,AL	;SAVE THE TRACK NUMBER
 0CA0 FEC4			INC	AH			;SECTOR = 1 TO 26 SO INC FIRST
 0CA2 8826BB04			MOV	SECTOR,AH		;SAVE THE SECTOR
 0CA6 E80501	   0DAE 	CALL	FIXCYL			;CHECK AND SET UP FOR DOUBLE DENSITY
 0CA9 C606BC0400		MOV	byte ptr NBYTES,0	;0 FOR 128 BYTE SECTORS
 0CAE C606BD041A		MOV	byte ptr EOT,26 	;26 SECTORS FOR SINGLE DENSITY
 0CB3 C606BE0407		MOV	byte ptr GPL,07 	;GAP3 LENGTH FOR 8272
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  31


 0CB8 C606BF0480		MOV	byte ptr DTL,128	;128 BYTES/SECTOR
 0CBD C706CA048000		MOV	word ptr TRANSFER,128	;128 BYTES TO TRANSFER PER SECTOR
 0CC3 890EC504			MOV	RTT,CX			;NUMBER OF SECTORS TO READ OR WRITE
 0CC7 E8CC00	   0D96 	CALL	SELECT_8
 0CCA E9B3FE	   0B80 	JMP	COMMON1

			DSSETUP:
 0CCD C606DC04FF		MOV	byte ptr DBLSDD,TRUE
 0CD2 EB05	   0CD9 	JMPS	SETUP
			DDSETUP:
 0CD4 C606DC0400		MOV	byte ptr DBLSDD,FALSE
			SETUP:
 0CD9 8BC2			MOV	AX,DX
 0CDB B208			MOV	DL,8
 0CDD F6F2			DIV	DL
 0CDF A2DB04			MOV	TRACK,AL
 0CE2 FEC4			INC	AH
 0CE4 8826BB04			MOV	SECTOR,AH
 0CE8 E8C300	   0DAE 	CALL	FIXCYL
			DD2:
 0CEB C606BC0403		MOV	byte ptr NBYTES,03	;1024 BYTE SECTORS IN DOUBLE DEN
 0CF0 C606BD0408		MOV	byte ptr EOT,08 	;8 SECTORS/TRACK
 0CF5 C606BE0435		MOV	byte ptr GPL,35H	;35H GAP3 LENGTH IN DD MODE
 0CFA C606BF04FF		MOV	byte ptr DTL,0FFH	;FF FOR OTHER THAN 128 BYTE SECTORS
 0CFF C706CA040004		MOV	word ptr TRANSFER,1024	;1024 BYTES PER SECTOR TO TRANSFER
 0D05 890EC504			MOV	RTT,CX			;SAVE NUMBER OF SECTORS TO TRANSFER
 0D09 A0B704			MOV	AL,CMND 		;GET COMMAND FROM IOPB
 0D0C 0C40			OR	AL,MFM			;SET TO DOUBLE DENSITY
 0D0E A2B704			MOV	CMND,AL 		;RETURN THE COMMAND
 0D11 E88200	   0D96 	CALL	SELECT_8		;SET FDC PARAMETERS FOR 8"
 0D14 E969FE       0B80         JMP     COMMON1

                        SS9SPTMINISETUP:
 0D17 C606DC0400                MOV     byte ptr DBLSDD,FALSE
 0D1C C606BD0409                MOV     EOT,9
 0D21 EB22         0D45         JMPS    MINISETUPCONT
                        SSMINISETUP:
 0D23 C606DC0400                MOV     byte ptr DBLSDD,FALSE
 0D28 C606BD0408                MOV     EOT,8
 0D2D EB16         0D45         JMPS    MINISETUPCONT

                        DS9SPTMINISETUP:
 0D2F C606DC04FF                MOV     byte ptr DBLSDD,TRUE
 0D34 C606BD0409                MOV     EOT,9 
 0D39 EB0A         0D45         JMPS    MINISETUPCONT 
                        DSMINISETUP:
 0D3B C606BD0408                MOV     EOT,8
 0D40 C606DC04FF                MOV     byte ptr DBLSDD,TRUE    ;ALWAYS DOUBLE SIDED
                        MINISETUPCONT:
 0D45 8BC2                      MOV     AX,DX           ;COMPUTE TRACK AND SECTOR
 0D47 B208                      MOV     DL,8            ;8 SECTORS PER TRACK
 0D49 F6F2                      DIV     DL
 0D4B A2DB04                    MOV     TRACK,AL
 0D4E FEC4                      INC     AH
 0D50 8826BB04                  MOV     SECTOR,AH
 0D54 E85700       0DAE         CALL    FIXCYL
 0D57 C606BC0402                MOV     byte ptr NBYTES,2       ;512 BYTE SECTORS
 0D5C C606BE042A                MOV     byte ptr GPL,2AH
 0D61 C606BF04FF                MOV     byte ptr DTL,0FFH
 0D66 C706CA040002              MOV     word ptr TRANSFER,512   ;512 BYTES PER SECTOR
 0D6C 890EC504                  MOV     RTT,CX
 0D70 A0B704                    MOV     AL,CMND
 0D73 0C40                      OR      AL,MFM          ;SET DOUBLE DENSITY MODE
 0D75 A2B704                    MOV     byte ptr CMND,AL        ;REPLACE MODIFIED COMMAND
 0D78 E80300       0D7E         CALL    SELECT_514              ;5 1/4 PARAMETER SETTING
 0D7B E902FE       0B80         JMP     COMMON1

                        SELECT_514:
 0D7E B00E                      MOV     AL,01110B       ;clear bit 7 of port C on 8255
 0D80 E6D6                      OUT     PAR_CTRL,AL
 0D82 B00B                      MOV     AL,01011B       ;SET BIT 5 TO ASSERT READY
 0D84 E6D6                      OUT     PAR_CTRL,AL 
 0D86 B003                      MOV     AL,03
 0D88 E8BC00       0E47         CALL    OUTFDC
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  32


 0D8B B0CF                      MOV     AL,0CFH
 0D8D E8B700       0E47         CALL    OUTFDC
 0D90 B065                      MOV     AL,65H          ;NON-DMA MODE
 0D92 E8B200       0E47         CALL    OUTFDC
 0D95 C3                        RET

                        SELECT_8:
 0D96 B00F                      MOV     AL,01111B       ;SET BIT 7 OF PORT C ON 8255
 0D98 E6D6                      OUT     PAR_CTRL,AL
 0D9A B00A                      MOV     AL,01010B       ;CLEAR BIT 5
 0D9C E6D6                      OUT     PAR_CTRL,AL
 0D9E B003                      MOV     AL,03H
 0DA0 E8A400       0E47         CALL    OUTFDC
 0DA3 B08F                      MOV     AL,8FH
 0DA5 E89F00       0E47         CALL    OUTFDC
 0DA8 B041                      MOV     AL,41H          ;NON-DMA MODE
 0DAA E89A00       0E47         CALL    OUTFDC
 0DAD C3                        RET

                        FIXCYL:
 0DAE F606DC04FF                TEST    byte ptr DBLSDD,TRUE
 0DB3 7422         0DD7         JZ      FIXCYL1
 0DB5 A0DB04                    MOV     AL,TRACK
 0DB8 D0E8                      SHR     AL,1 
 0DBA A2B904                    MOV     byte ptr CYL,AL
 0DBD 730C         0DCB         JNC     HEAD0
 0DBF C606BA0401                MOV     byte ptr HEAD,1
 0DC4 800EB80404                OR      byte ptr UNIT,4H
 0DC9 EB1C         0DE7         JMPS    FIXCYLRET
                        HEAD0:
 0DCB C606BA0400                MOV     byte ptr HEAD,0
 0DD0 8026B80403                AND     byte ptr UNIT,03H
 0DD5 EB10         0DE7         JMPS    FIXCYLRET
                        FIXCYL1:
 0DD7 C606BA0400                MOV     byte ptr HEAD,0
 0DDC 8026B80403                AND     byte ptr UNIT,03H
 0DE1 A0DB04                    MOV     AL,TRACK
 0DE4 A2B904                    MOV     CYL,AL
                        FIXCYLRET:
 0DE7 C3                        RET

                        SHAKEHEAD:
 0DE8 A0C004                    MOV     AL,RETRY        ;INC THE RETRY COUNT
 0DEB FEC0                      INC     AL
 0DED A2C004                    MOV     RETRY,AL
 0DF0 3C01                      CMP     AL,1            ;IS THIS THE FIRST RETRY?
 0DF2 7503         0DF7         JNE     SHRET           ;IF NOT RETURN TO CALLING ROUTINE
 0DF4 E88300       0E7A         CALL    RECAL           ;ELSE HOME HEAD AND TRY AGAIN
 0DF7 C3                SHRET:  RET

                        ;TC ISSUES A TC PULSE TO THE FDC TO TERMINATE THE PRESENT COMMAND.
                        TC:     
 0DF8 B00D                      MOV     AL,01101B       ;SET BIT 6 OF PORTC
 0DFA E6D6                      OUT     PAR_CTRL,AL
 0DFC 50                        PUSH    AX
 0DFD 58                        POP     AX              ;KILL SOME TIME
 0DFE B00C                      MOV     AL,01100B       ;NO BACK TO 0
 0E00 E6D6                      OUT     PAR_CTRL,AL
 0E02 C3                        RET

                        ;CHECK CHECKS THE RESULTS OF THE LAST READ OR WRITE OPERATION.
                        ;IF ANY BITS EXCEPT THE END OF CYLINDER FLAG ARE SET THE CARRY
                        ;FLAG IS CLEARED TO INDICATE AN ERROR.

                        CHECK:
 0E03 A0D204                    MOV     AL,ST1 
 0E06 247F                      AND     AL,7FH
 0E08 7502         0E0C         JNZ     CERR
 0E0A F9                        STC                     ;INDICATE ALL OK
 0E0B C3                        RET
 0E0C F8                CERR:   CLC
 0E0D C3                        RET                     ;ERROR RETURN WITH NO CARRY


CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  33


                        INRSLT:
                        ;GETS THE RESULTS FROM THE FDC AFTER THE COMPLETION OF A
                        ;COMMAND.
 0E0E 57                        PUSH    DI
 0E0F FC                        CLD
 0E10 BFD104                    MOV     DI,offset ST0           ;POINT TO RESULT AREA
 0E13 E84300       0E59 B005:   CALL    INFDC
 0E16 7303         0E1B         JNC     B004            ;READ THE FDC UNTIL IT CHANGES
                                                        ;FROM THE INPUT`STATE TO THE OUTPUT
                                                        ;STATE
 0E18 AA                        STOSB
 0E19 EBF8         0E13         JMPS    B005
 0E1B 5F                B004:   POP     DI
 0E1C C3                        RET

                        SEEK:
                        ;CAUSES A SEEK TO THE TRACK SPECIFIED IN THE GLOBAL PARAMETER
                        ;CYL ON THE UNIT SPECIFIED IN THE GLOBAL PARAMETER UNIT.
 0E1D 50                        PUSH    AX
 0E1E B00F              SEEK1:  MOV     AL,SEEKCMND
 0E20 E82400       0E47         CALL    OUTFDC
 0E23 A0B804                    MOV     AL,UNIT
 0E26 2403                      AND     AL,03H
 0E28 E81C00       0E47         CALL    OUTFDC
 0E2B A0B904                    MOV     AL,CYL
 0E2E E81600       0E47         CALL    OUTFDC
 0E31 E86100       0E95         CALL    WAIT_SEEK_DONE
 0E34 E83200       0E69         CALL    SENSE
 0E37 58                        POP     AX
 0E38 C3                        RET

                        OUTIOPB:
 0E39 50                        PUSH    AX
 0E3A 51                        PUSH    CX
 0E3B B90900                    MOV     CX,9
                        OUTIOPB1:
 0E3E AC                        LODSB
 0E3F E80500       0E47         CALL    OUTFDC
 0E42 E2FA         0E3E         LOOP    OUTIOPB1
 0E44 59                        POP     CX
 0E45 58                        POP     AX
 0E46 C3                        RET

                        OUTFDC:
                        ;OUTPUTS THE BYTE IN AL TO THE COMMAND PORT OF THE FDC
                        ;IF THe FDC IS IN THE WRONG STATE I.E. IN THE INPUT MODE
                        ;THE CARRY FLAG IS SET ON RETURN.

 0E47 50                        PUSH    AX
 0E48 E490              B006:   IN      AL,FDC_STATUS
 0E4A A880                      TEST    AL,80H
 0E4C 74FA         0E48         JZ      B006
 0E4E A840                      TEST    AL,40H
 0E50 58                        POP     AX
 0E51 7504         0E57         JNZ     B007
 0E53 E692                      OUT     FDC_COMMAND,AL
 0E55 F9                        STC
 0E56 C3                        RET
                        B007:
 0E57 F8                        CLC
 0E58 C3                        RET

                        INFDC:
                        ;INPUTS A BYTE FROM THE RESULT REGISTER AND RETURNS IT IN AL.
                        ;IF THE FDC IS IN THE WRONG MODE (OUTPUT RATHER THE INPUT MODE)
                        ;THE CARRY FLAG IS CLEAR ON RETURN.

 0E59 E490              B008:   IN      AL,FDC_STATUS 
 0E5B A880                      TEST    AL,80H
 0E5D 74FA         0E59         JZ      B008
 0E5F A840                      TEST    AL,40H
 0E61 7404         0E67         JZ      B009
 0E63 E492                      IN      AL,FDC_DATA
 0E65 F9                        STC
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  34


 0E66 C3                        RET
 0E67 F8                B009:   CLC
 0E68 C3                RET7:   RET

                        SENSE:
                        ;CAUSES A SENSE INTERRUPT STATUS COMMAND TO BE EXECUTED AND
                        ;GETS THE RESULTS OF`THE COMMAND. THE RESULTS ARE RETURNED 
                        ;IN GLOBAL PARAMETERS ST0 AND ST1.
 0E69 B008                      MOV     AL,08H
 0E6B E8D9FF       0E47         CALL    OUTFDC
 0E6E E8E8FF       0E59         CALL    INFDC
 0E71 3C80                      CMP     AL,80H
 0E73 74F3         0E68         JE      RET7 
 0E75 E8E1FF       0E59         CALL    INFDC
 0E78 EBEF         0E69         JMPS    SENSE

                        RECAL:
                        ;MOVES THE HEAD ON THE SPECIFIED DRIVE TO THE HOME POSITION.
 0E7A B007                      MOV     AL,07H
 0E7C E8C8FF       0E47         CALL    OUTFDC
 0E7F A0B804                    MOV     AL,byte ptr UNIT
 0E82 2403                      AND     AL,03H
 0E84 E8C0FF       0E47         CALL    OUTFDC
 0E87 E80B00       0E95         CALL    WAIT_SEEK_DONE
 0E8A E8DCFF       0E69         CALL    SENSE
 0E8D C3                        RET

                        WTINT:
                        ;WAITS FOR THE INTERRUPT LINE FROM THE FDC TO BECOME ACTIVE.

 0E8E E490                      IN      AL,FDC_STATUS
 0E90 A820                      TEST    AL,020H         ;NONDMA MODE BIT GOES TO 0 AFTER EXEC PHASE 
 0E92 75FA         0E8E         JNZ     WTINT 
 0E94 C3                        RET 

                        WAIT_SEEK_DONE:
 0E95 B008                      MOV     AL,SENSE_INT_CMND
 0E97 E8ADFF       0E47         CALL    OUTFDC
 0E9A E8BCFF       0E59         CALL    INFDC
 0E9D A820                      TEST    AL,20H                  ;INTERRUPT COMPLETE STATUS?
 0E9F 750C         0EAD         JNZ     WAIT_SEEK_DONE_RET      ;IF A '1' THEN DONE
 0EA1 3C80                      CMP     AL,80H                  ;NO OP
 0EA3 7403         0EA8         JE      WAIT_SEEK_DONE_DELAY
 0EA5 E8B1FF       0E59         CALL    INFDC
                        WAIT_SEEK_DONE_DELAY:
 0EA8 E80600       0EB1         CALL    KILL_TIME
 0EAB EBE8         0E95         JMPS    WAIT_SEEK_DONE
                        WAIT_SEEK_DONE_RET:
 0EAD E8A9FF       0E59         CALL    INFDC                   ;GET LAST BYTE OF COMMAND
 0EB0 C3                        RET

                        KILL_TIME: 
 0EB1 51                        PUSH    CX
 0EB2 B9E803                    MOV     CX,1000
                        KILL_TIME_LOOP:
 0EB5 50                        PUSH    AX
 0EB6 58                        POP     AX
 0EB7 E2FC         0EB5         LOOP    KILL_TIME_LOOP
 0EB9 59                        POP     CX
 0EBA C3                        RET


                        JMPTBL:
 0EBB 920C                      DW      SDSETUP
 0EBD 920C                      DW      SDSETUP
 0EBF D40C                      DW      DDSETUP
 0EC1 D40C                      DW      DDSETUP
 0EC3 CD0C                      DW      DSSETUP
 0EC5 CD0C                      DW      DSSETUP
 0EC7 230D                      DW      SSMINISETUP
 0EC9 3B0D                      DW      DSMINISETUP 
                        SD_JMPTBL:
 0ECB 230D                      DW      SSMINISETUP
 0ECD 230D                      DW      SSMINISETUP
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  35


 0ECF 230D                      DW      SSMINISETUP
 0ED1 3B0D                      DW      DSMINISETUP
 0ED3 3B0D                      DW      DSMINISETUP
 0ED5 3B0D                      DW      DSMINISETUP
 0ED7 170D                      DW      SS9SPTMINISETUP
 0ED9 170D                      DW      SS9SPTMINISETUP
 0EDB 170D                      DW      SS9SPTMINISETUP
 0EDD 2F0D                      DW      DS9SPTMINISETUP
 0EDF 2F0D                      DW      DS9SPTMINISETUP
 0EE1 2F0D                      DW      DS9SPTMINISETUP
                        UNITTAB:
 0EE3 00                        DB      0
 0EE4 01                        DB      1
 0EE5 00                        DB      0
 0EE6 01                        DB      1
 0EE7 00                        DB      0
 0EE8 01                        DB      1
 0EE9 02                        DB      2
 0EEA 02                        DB      2
                        SD_UNITTAB:
 0EEB 00                        DB      0
 0EEC 01                        DB      1
 0EED 02                        DB      2
 0EEE 00                        DB      0
 0EEF 01                        DB      1
 0EF0 02                        DB      2
 0EF1 00                        DB      0
 0EF2 01                        DB      1
 0EF3 02                        DB      2
 0EF4 00                        DB      0
 0EF5 01                        DB      1
 0EF6 02                        DB      2

                        ;Memory tests for inclusion in the monitor.
                        ;
                        ;Test 0 tests the specified range for the ability to store 0's
                        ;Format:
                        ; 
                        ;       V 0 (starting segment) (number of segments) (itteration count)
                        ;       example: V 0 40 1000 10
                        ;       Fills memory begining at 40:0 for 1000 segments with 0's
                        ;       and then verifies that range. This is done 16 times.
                        ;
                        ;Test 1 tests the specified range for the ability to store 1's
                        ;Format:
                        ;
                        ;       V 1 (starting segment) (number of segments) (itteration count)
                        ;
                        ;Test 2 test the specified range for the ability to hold an alternating
                        ;1's and 0's pattern. The segment under test is first written with 055h
                        ;and verified and then written with 0aah and then verified.
                        ;Format:
                        ;
                        ;       V 2 (starting segment) (number of segments) (itteration count)
                        ;
                        ;Test 3 tests memory over the specified range with a shifting 1 in the 
                        ;locations being tested. In order to test each location with any one
                        ;bit set an itteration count of 8 or more should be specified.
                        ;Format:
                        ;
                        ;       V 3 (starting segment) (number of ssegments) (itteration count)
                        ;
                        ;Test 4 tests memory over the specified range for a rotating 0 pattern.
                        ;In order to test each location with all possible single bits clear an
                        ;itteration count of 8 must be specified.
                        ;Format:
                        ;
                        ;       V 4 (starting segment) (number of segments) (itteration count)
                        ;
                        VTEST:
 0EF7 B90100                    MOV     CX,1            ;GET TEST NUMBER
 0EFA E86BF5       0468         CALL    GETHEX  
 0EFD 80FA04                    CMP     DL,4
 0F00 7E03         0F05         JLE     VTESTCONT
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  36


 0F02 E9E1F5       04E6         JMP     PERR
                        VTESTCONT:
 0F05 52                        PUSH    DX
 0F06 B90400                    MOV     CX,4            ;GET THE STARTING SEGMENT
 0F09 E85CF5       0468         CALL    GETHEX
 0F0C 8916DF04                  MOV     FIRSTSEG,DX     ;SAVE IT
 0F10 B90400                    MOV     CX,4            ;GET THE NUMBER OF SEGMENTS TO TEST
 0F13 E852F5       0468         CALL    GETHEX
 0F16 8916E104                  MOV     NUMSEGS,DX      ;SAVE IT
 0F1A B90400                    MOV     CX,4            ;GET THE ITTERATION COUNT
 0F1D E848F5       0468         CALL    GETHEX
 0F20 8916E304                  MOV     LOOPCNT,DX
 0F24 E8B9F5       04E0         CALL    GETEOL          ;MAKE SURE END OF COMMAND STRING
 0F27 C706E5040000              MOV     ERRORS,0        ;ZERO ERROR COUNT
 0F2D 5B                        POP     BX
 0F2E D1E3                      SHL     BX,1            ;TIMES 2 FOR OFFSET INTO JMP TABLE
 0F30 2EFFA7DC0F                JMP     CS:TSTTBL[BX]   ;GO START EXECUTING THE TEST

                        TEST0:
 0F35 B000                      MOV     AL,0            ;TEST VALUE
                        TEST0B:
 0F37 E83F00       0F79         CALL    TESTEXEC        ;GO TEST THE MEMORY
 0F3A FF0EE304                  DEC     LOOPCNT         ;DECREMENT THE ITTERATION COUNT
 0F3E 75F7         0F37         JNZ     TEST0B          ;IF NOT DONE EXECUTE THE TEST AGAIN
                        TEST0C:
 0F40 BEE60F                    MOV     SI,offset TSTMSG1       ;ANNOUNCE END OF TEST WITH ERROR COUNT
 0F43 E843F3       0289         CALL    PRINTMES
 0F46 8B16E504                  MOV     DX,ERRORS       ;GET THE NUMBER OR ERRORS, 64K MAX COUNT
 0F4A E877F3       02C4         CALL    OUT16           ;PRINT IT
 0F4D E911F3       0261         JMP     CRLF            ;EXIT TO COMMAND AGAIN
                        TEST1:
 0F50 B0FF                      MOV     AL,0FFH         ;TEST MEMORY WITH 1'S
 0F52 EBE3         0F37         JMPS    TEST0B          
                        TEST2:
 0F54 B055                      MOV     AL,055H         ;TEST WITH FIRST ALTERNATING PATERN
 0F56 E82000       0F79         CALL    TESTEXEC
 0F59 B0AA                      MOV     AL,0AAH         ;OTHER ALTERNATING PATTERN
 0F5B E81B00       0F79         CALL    TESTEXEC
 0F5E FF0EE304                  DEC     LOOPCNT
 0F62 75F0         0F54         JNZ     TEST2           ;DO AGAIN IF NOT COMPLETE
 0F64 EBDA         0F40         JMPS    TEST0C          ;OTHERWISE PRINT TERMINATION MESSAGE
                        TEST3:
 0F66 B001                      MOV     AL,1            ;STARTING PATTERN FOR ROTATING 1 TEST
                        TEST3A:
 0F68 E80E00       0F79         CALL    TESTEXEC        ;DO THE TEST
 0F6B FF0EE304                  DEC     LOOPCNT         ;DECREMENT ITTERATION COUNT
 0F6F 74CF         0F40         JZ      TEST0C          ;PRINT EXIT INFO IF DONE
 0F71 D0C0                      ROL     AL,1            ;OTHERWISE ROTATE THE PATTERN
 0F73 EBF3         0F68         JMPS    TEST3A          ;AND DO IT ALL AGAIN
                        TEST4:
 0F75 B0FE                      MOV     AL,0FEH         ;SAME AS TEST 3 WITH ROTATING 0
 0F77 EBEF         0F68         JMPS    TEST3A

                        TESTEXEC:
 0F79 8B0EE104                  MOV     CX,NUMSEGS      ;GET NUMBER OF SEGMENTS TO TEST
 0F7D 8B1EDF04                  MOV     BX,FIRSTSEG
 0F81 06                        PUSH    ES              ;SAVE CURRENT ES SEGMENT
                        TESTEXECLOOP:
 0F82 8EC3                      MOV     ES,BX           ;SET UP ACCESABILITY TO NEXT 16 BYTE BLOCK
 0F84 BF0000                    MOV     DI,0            ;OFFSET WITHIN BLOCK
 0F87 51                        PUSH    CX              ;SAVE LOOP COUNT
 0F88 B91000                    MOV     CX,16           ;16 BYTES PER PARAGRAPH
 0F8B F3AA                      REP     STOSB           ;FILL 16 BYTES WITH DATA
 0F8D BF0000                    MOV     DI,0            ;RESET TO SEE IF DATA IS THERE
 0F90 B91000                    MOV     CX,16
                        REENTR:
 0F93 F3AE                      REPE    SCASB           ;SCAN 16 BYTES FOR CORRECT DATA
 0F95 7506         0F9D         JNE     REPORT          ;REPORT ERROR IF LAST COMPARE NOT EQUAL
                        REENTR1:
 0F97 43                        INC     BX              ;NEXT PARAGRAPH
 0F98 59                        POP     CX              ;GET NUMBER OF PARAGRAPHS BACK
 0F99 E2E7         0F82         LOOP    TESTEXECLOOP    ;DO UNTILL ALL PARAGRAPHS DONE
 0F9B 07                        POP     ES              ;GET BACK ORIGINAL ES
 0F9C C3                        RET                     ;ALL DONE TESTING ONE PASS
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  37



                        REPORT:
 0F9D 50                        PUSH    AX
 0F9E 53                        PUSH    BX
 0F9F 51                        PUSH    CX
 0FA0 52                        PUSH    DX
 0FA1 57                        PUSH    DI              ;SAVE WORK REGISTERS
 0FA2 8B1EE504                  MOV     BX,ERRORS       ;HOW MANY ERRORS HAVE THERE BEEN
 0FA6 43                        INC     BX              ;INCREMENT IT
 0FA7 742A         0FD3         JZ      REPORTEXIT      ;IF AT MAX COUNT DONT SAVE NEW VALUE
 0FA9 891EE504                  MOV     ERRORS,BX       ;OTHERWISE SAVE NEW ERROR COUNT
 0FAD 83FB0A                    CMP     BX,10           ;SHOULD WE PRINT THE ERROR?
 0FB0 7721         0FD3         JA      REPORTEXIT      ;IF TEN OR MORE ERRORS SKIP PRINTING
 0FB2 50                        PUSH    AX              ;SAVE TEST VALUE BYT
 0FB3 BEF00F                    MOV     SI,offset TSTMSG2 ;PRINT 'Address '
 0FB6 E8D0F2       0289         CALL    PRINTMES
 0FB9 4F                        DEC     DI              ;POINT AT FAILING LOCATION
 0FBA E8F8F2       02B5         CALL    OUTDI           ;PRINT AS 5 DIGIT ABSOLUTE ADDRESS
 0FBD BEFB0F                    MOV     SI,offset TSTMSG3 ;PRINT ' Expected data '
 0FC0 E8C6F2       0289         CALL    PRINTMES
 0FC3 58                        POP     AX              ;GET EXPECTED DATA BACK
 0FC4 E804F3       02CB         CALL    HEX             ;PRINT AL IN HEX
 0FC7 BE0B10                    MOV     SI,offset TSTMSG4       ;PRINT ' Actual data '
 0FCA E8BCF2       0289         CALL    PRINTMES
 0FCD 268A05                    MOV     AL,ES:[DI]
 0FD0 E8F8F2       02CB         CALL    HEX             ;PRINT IT
                        REPORTEXIT:
 0FD3 5F                        POP     DI              ;RESTORE SAVED REGISTERS
 0FD4 5A                        POP     DX
 0FD5 59                        POP     CX
 0FD6 5B                        POP     BX
 0FD7 58                        POP     AX
 0FD8 E3BD         0F97         JCXZ    REENTR1         ;IF DONE WITH PRESENT SEGMENT DO NEXT
 0FDA EBB7         0F93         JMPS    REENTR          ;IF NOT DONE WITH SEGMENT FINISH
                        TSTTBL:
 0FDC 350F                      DW      TEST0
 0FDE 500F                      DW      TEST1
 0FE0 540F                      DW      TEST2
 0FE2 660F                      DW      TEST3
 0FE4 750F                      DW      TEST4
                        TSTMSG1:
 0FE6 0D0A4572726F              DB      CR,LF,'Errors ',0 
      72732000
                        TSTMSG2:
 0FF0 0D0A41646472              DB      CR,LF,'Address ',0
      6573732000
                        TSTMSG3:
 0FFB 204578706563              DB      ' Expected data ',0
      746564206461
      74612000
                        TSTMSG4:
 100B 204163747561              DB      ' Actual data ',0
      6C2064617461
      2000

=                       INCLUDE         INIT186.A86
=                               ORG     1C00H           ;ORG TO LAST 1K OF MEMORY SO UMCS WILL BE
=                                                       ;ACTIVE
=                       START:
=1C00 8CC8                      MOV     AX,CS
=1C02 8ED8                      MOV     DS,AX
=1C04 8EC0                      MOV     ES,AX
=1C06 BE291C                    MOV     SI,OFFSET INIT_TABLE
=1C09 FC                        CLD
=                       INIT_LOOP:
=1C0A AD                        LODSW                   ;GET PORT ADDRESS
=1C0B 85C0                      TEST    AX,AX           ;IF 0 THEN DONE INIT
=1C0D 7406         1C15         JZ      DONE_INIT1      ;DONE WITH 80186 INIT IF 0
=1C0F 8BD0                      MOV     DX,AX
=1C11 AD                        LODSW                   ;GET THE VALUE TO SEND
=1C12 EF                        OUT     DX,AX           ;OUTPUT IT TO THE REGISTER
=1C13 EBF5         1C0A         JMPS    INIT_LOOP
=                       DONE_INIT1:
=1C15 BE5F1C                    MOV     SI,OFFSET PERIPHERAL_INIT_TAB
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  38


=1C18 BA0000                    MOV     DX,0            ;RANGE OF 80H TO 0FFH SO DH ALWAYS 0
=                       INIT_LOOP1:
=1C1B AC                        LODSB                   ;GET ADDRESS, ADDRESS OF 0 TERMINATES
=1C1C 84C0                      TEST    AL,AL
=1C1E 7406         1C26         JZ      DONE_INIT2
=1C20 8AD0                      MOV     DL,AL
=1C22 AC                        LODSB
=1C23 EE                        OUT     DX,AL           ;OUTPUT TABLE DATA TO TABLE I/O DEVICE
=1C24 EBF5         1C1B         JMPS    INIT_LOOP1
=                       DONE_INIT2:
=1C26 E9ECE3       0015         JMP     INIT            ;START MONITOR EXECUTION
=
=  1C29                 INIT_TABLE      EQU     $
=1C29 A0FF                      DW      UMCS_REG
=1C2B 00F0                      DW      UMCS_VALUE
=1C2D A2FF                      DW      LMCS_REG
=1C2F F83F                      DW      LMCS_VALUE
=1C31 A4FF                      DW      PACS_REG
=1C33 3A00                      DW      PACS_VALUE
=1C35 A6FF                      DW      MMCS_REG
=1C37 3840                      DW      MMCS_VALUE
=1C39 A8FF                      DW      MPCS_REG
=1C3B 38A0                      DW      MPCS_VALUE
=1C3D 52FF                      DW      MAX_CNT_REGA_TMR0
=1C3F 0600                      DW      REGA_9600
=1C41 54FF                      DW      MAX_CNT_REGB_TMR0
=1C43 0700                      DW      REGB_9600
=1C45 56FF                      DW      TMR0_CONTROL_REG
=1C47 03C0                      DW      TMR0_CTRL_REG_VAL
=1C49 5AFF                      DW      MAX_CNT_REGA_TMR1
=1C4B 0600                      DW      REGA_9600
=1C4D 5CFF                      DW      MAX_CNT_REGB_TMR1
=1C4F 0700                      DW      REGB_9600
=1C51 5EFF                      DW      TMR1_CONTROL_REG
=1C53 03C0                      DW      TMR1_CTRL_REG_VAL
=1C55 62FF                      DW      MAX_CNT_REG_TMR2
=1C57 204E                      DW      TMR2_REGA_DIVISOR
=1C59 66FF                      DW      TMR2_CONTROL_REG
=1C5B 01E0                      DW      TMR2_CTRL_REG_VAL
=1C5D 0000                      DW      0
=
=                       PERIPHERAL_INIT_TAB:
=1C5F 82                        DB      SER_PORT1_COMMAND       ;INIT USART 1, FIRST 3 NULS
=1C60 00                        DB      0
=1C61 82                        DB      SER_PORT1_COMMAND
=1C62 00                        DB      0
=1C63 82                        DB      SER_PORT1_COMMAND
=1C64 00                        DB      0
=1C65 82                        DB      SER_PORT1_COMMAND       ;NOW RESET IT
=1C66 40                        DB      USART_RESET
=1C67 82                        DB      SER_PORT1_COMMAND       ;NEW MODE
=1C68 CE                        DB      USART_MODE
=1C69 82                        DB      SER_PORT1_COMMAND       ;ENABLE TX AND RX ASSERT RTS, DTR
=1C6A 37                        DB      USART_INST
=1C6B C2                        DB      SER_PORT2_COMMAND       ;NOW SAME FOR USART2
=1C6C 00                        DB      0
=1C6D C2                        DB      SER_PORT2_COMMAND
=1C6E 00                        DB      0
=1C6F C2                        DB      SER_PORT2_COMMAND
=1C70 00                        DB      0
=1C71 C2                        DB      SER_PORT2_COMMAND
=1C72 40                        DB      USART_RESET
=1C73 C2                        DB      SER_PORT2_COMMAND
=1C74 CE                        DB      USART_MODE
=1C75 C2                        DB      SER_PORT2_COMMAND
=1C76 37                        DB      USART_INST
=1C77 D6                        DB      PAR_CTRL                ;NOW INIT 8255
=1C78 82                        DB      PAR_PORT_MODE           ;SET MODE
=1C79 D4                        DB      PORTC                   ;SET PORT C TO INITIAL VALUE
=1C7A 0F                        DB      PORTC_INITIAL
=1C7B 00                        DB      0                       ;**** END OF INIT TABLE ****
=


