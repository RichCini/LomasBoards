			DISKSETUP:
			;GETS THE PARAMETERS FOR DISK OPERATIONS FROM THE COMMAND LINE.
 0750 B90500			MOV	CX,5		;5DIGIT ADDRESS FIRST
 0753 E812FD	   0468 	CALL	GETHEX
 0756 E8C8FB	   0321 	CALL	GETSEG		;CONVERT TO SEGMENT AND OFFSET
 0759 50			PUSH	AX		;SAVE THE SEGMENT
 075A 52			PUSH	DX		;SAVE THE TRANSFER OFFSET
 075B B90100			MOV	CX,1		;1 DIGIT DRIVE NUMBER NEXT
 075E E807FD	   0468 	CALL	GETHEX
 0761 52			PUSH	DX		;SAVE THE UNIT NUMBER
 0762 B90300			MOV	CX,3		;STARTING RECORD NUMBER NEXT
 0765 E800FD	   0468 	CALL	GETHEX		;GET THE NUMBER
 0768 52			PUSH	DX		;SAVE THE RECORD NUMBER
 0769 B90300			MOV	CX,3		;NUMBER OF RECORDS TO TRANSFER
 076C E8F9FC	   0468 	CALL	GETHEX		;GET IT
 076F 52			PUSH	DX
 0770 E86DFD	   04E0 	CALL	GETEOL		;CHECK FOR ERRORS
 0773 59			POP	CX		;PUT RECORDS TO TRANSFER IN CX
 0774 5A			POP	DX		;PUT OTHER PARAMETERS IN THE RIGHT
 0775 58			POP	AX		;REGISTERS
 0776 5B			POP	BX
 0777 1F			POP	DS
 0778 C3			RET			;ALL SET
			BOOT:

 0779 E4D2			IN	AL,SWITCH_PORT		;FIND OUT IF 5.25 OR 8"
 077B A808                      TEST    AL,8H                   ;SWITCH 4 ON = 8"
 077D 7556	   07D5 	JNZ	BOOT_525

			;Switch 4 on so boot from 8" system
                        ;First try to boot as if the drive is double density. If that fails
                        ;try to boot as single density. If both fail report unable to boot.
                        ;If boot is sucessful the first 2 tracks are loaded at address 50:0
                        ;an a GO command is executed to begin exicution at that point.

 077F C706B1045000              MOV     word ptr CSSAVE,50H ;SETS UP TO START EXECUTION AT 
 0785 C706B3040000              MOV     word ptr IPSAVE,0H    ;BEGINING OF DATA LOADED
 078B C706A3040004              MOV     word ptr SPSAVE,400H
 0791 C706AF040000              MOV     word ptr SSSAVE,0H      
 0797 C606D004FF                MOV     byte ptr DONTPRNT,TRUE ;DISABLE ERROR PRINTING FOR BOOT
 079C 57                        PUSH    DI              ;SAVE COMMAND POINTER
                        DDBOOT:
 079D 1E                        PUSH    DS
 079E BB5000                    MOV     BX,50H          ;POINT TO SEGMENT TO READ TO
 07A1 8EDB                      MOV     DS,BX
 07A3 BB0000                    MOV     BX,0H           ;SET UP FOR DOUBLE DENSITY first
 07A6 B92000                    MOV     CX,20H          ;READ 32 1K SECTORS
 07A9 BA0000                    MOV     DX,0            ;STARTING AT SECTOR 1 TRACK 0
 07AC B002                      MOV     AL,2            ;INDICATE DS1 IN DD FORMAT
 07AE E87603       0B27         CALL    READ
 07B1 1F                        POP     DS
 07B2 731D         07D1         JNC     BOOTOK
                        SDBOOT:
 07B4 1E                        PUSH    DS
 07B5 BB5000                    MOV     BX,50H
 07B8 8EDB                      MOV     DS,BX
 07BA BB0000                    MOV     BX,0H           ;SET UP READ PARAMETERS
 07BD B93400                    MOV     CX,52           ;READ THE WHOLE FIRST 2 TRACKS
 07C0 BA0000                    MOV     DX,0            ;STARTING WITH THE FIRST SECTOR
 07C3 B000                      MOV     AL,0            ;
 07C5 E85F03       0B27         CALL    READ            ;READ IT IN
 07C8 1F                        POP     DS 
 07C9 7306         07D1         JNC     BOOTOK          ;IF NO CARRY ALL'S OK
                        boot_error:
 07CB BE0D08                    MOV     SI,offset BADBOOT
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  22


 07CE E922FD       04F3         JMP     PRINT
                        BOOTOK:
 07D1 5F                        POP     DI              ;RESTORE COMMAND STRING POINTER
 07D2 E93E02       0A13         JMP     GO              ;FINISH UP COMMAND LINE


                        BOOT_525:
 07D5 C706B1040028              MOV     word ptr CSSAVE,2800H ;SETS UP TO START EXECUTION AT 
 07DB C706B3040000              MOV     word ptr IPSAVE,0H    ;BEGINING OF DATA LOADED
 07E1 C706A3040004              MOV     word ptr SPSAVE,400H
 07E7 C706AF040000              MOV     word ptr SSSAVE,0H      
