			;System Equates

=			INCLUDE 	T186.LIB		;EQUATES FOR THUNDER186
=			;last change 4/07/84 14:32
=
=			;Equates for THUNDER 186 processor board.
=			; These equates may be included in a source file to define
=			; the location of various I/O devices and system parameters.
=			;
=
=			;Chip select register locations
=
=  FFA0 		UMCS_reg	EQU	0FFA0H		;Upper memory size
=  FFA2 		LMCS_reg	EQU	0FFA2H		;Lower memory size
=  FFA4 		PACS_reg	EQU	0FFA4H		;Peripheral chip select base address
=  FFA6 		MMCS_reg	EQU	0FFA6H		;Mid-range memory base(not used)
=  FFA8 		MPCS_reg	EQU	0FFA8H		;Mid-range memory size(not used)
=
=			;Chip select values for THUNDER 186 assumed by all LDP software.
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   2


=
=  F000 		UMCS_value	EQU	0F000H		;Assume top 64K = EPROM
=  3FF8 		LMCS_value	EQU	03FF8H		;Bottom 256K = onboard RAM
=  A038 		MPCS_value	EQU	0A038H		;Set base address out of way, PCS0-4
=								;in I/O space PCS5=A0 PCS6=A1
=  003A 		PACS_value	EQU	0003AH		;Base address of peripherals = 0
=								; 2 waitstates obey ready line
=  4038 		MMCS_value	EQU	04038H		;Unused, set for base of 40000H
=
=			;
=			;Equates for the internal DMA controller
=			;
=			;		**** CHANEL 0 ****
=			;
=  FFC0 		SOURCE_PTR_LOWER_CH0	EQU	0FFC0H	;Source pointer bits 0 thru 15
=  FFC2 		SOURCE_PTR_UPPER_CH0	EQU	0FFC2H	;Source pointer bits 16 thru 19
=  FFC4 		DEST_PTR_LOWER_CH0	EQU	0FFC4H	;Destination pointer bits 0 thru 15
=  FFC6 		DEST_PTR_UPPER_CH0	EQU	0FFC6H	;Destination pointer bits 16 thru 19
=  FFC8 		TRANSFER_COUNT_CH0	EQU	0FFC8H	;16 bit transfer count(64K max)
=  FFCA 		CONTROL_WORD_CH0	EQU	0FFCAH	;Control word for DMA
=			;
=			;		**** CHANNEL 1 ****
=			;
=  FFD0 		SOURCE_PTR_LOWER_CH1	EQU	0FFD0H	;Source pointer bits 0 thru 15
=  FFD2 		SOURCE_PTR_UPPER_CH1	EQU	0FFD2H	;Source pointer bits 16 thru 19
=  FFD4 		DEST_PTR_LOWER_CH1	EQU	0FFD4H	;Destination pointer bits 0 thru 15
=  FFD6 		DEST_PTR_UPPER_CH1	EQU	0FFD6H	;Destination pointer bits 16 thru 19
=  FFD8 		TRANSFER_COUNT_CH1	EQU	0FFD8H	;16 bit transfer count(64K max)
=  FFDA 		CONTROL_WORD_CH1	EQU	0FFDAH	;Control word for DMA
=			;
=			; DMA control words commonly used
=			;
=  1486 		MEM_TO_IO	EQU	0001010010000110b
=								 ;Memory source, I/O destination,
=								 ;inc the source ptr each transfer
=								 ;sync on dest
=								 ;start the channel, do byte transfers
=  A046 		IO_TO_MEM	EQU	1010000001000110b
=								 ;I/O source, Memory destination,
=								 ;inc the destination ptr each trans
=								 ; sync on source,
=								 ;start the channel, do byte transfers
=			;
=			; Timer Equates
=			;
=
=  FF50 		COUNT_REG_TMR0		EQU	0FF50H	;Timer 0 count register
=  FF52 		MAX_CNT_REGA_TMR0	EQU	0FF52H	;REGA max count value
=  FF54 		MAX_CNT_REGB_TMR0	EQU	0FF54H	;REGB max count value
=  FF56 		TMR0_CONTROL_REG	EQU	0FF56H	;Timer 1 control register
=  FF58 		COUNT_REG_TMR1		EQU	0FF58H	;Timer 1 count register
=  FF5A 		MAX_CNT_REGA_TMR1	EQU	0FF5AH	;REGA max count value
=  FF5C 		MAX_CNT_REGB_TMR1	EQU	0FF5CH	;REGB max count value
=  FF5E 		TMR1_CONTROL_REG	EQU	0FF5EH	;Timer 1 control register
=  FF60 		COUNT_REG_TMR2		EQU	0FF60H	;Timer 2 count register
=  FF62 		MAX_CNT_REG_TMR2	EQU	0FF62H	;Timer 2 max count register
=  FF66 		TMR2_CONTROL_REG	EQU	0FF66H	;Timer 2 control register
=
=  C003 		TMR0_CTRL_REG_VAL	EQU	1100000000000011B
=							;Enable the counter, don't generate interrupts
=							;reset max count, use input as enable of
=							;counter(can only be enable, or retrigger),
=							;don't prescale by timer 2, use internal
=							;clocking, alternate between Max count reg A
=							;and reg B, do continuously
=  C003 		TMR1_CTRL_REG_VAL	EQU	TMR0_CTRL_REG_VAL
=							;See above description
=  E001 		TMR2_CTRL_REG_VAL	EQU	1110000000000001B
=							;Enable counter, generate interrupts, reset
=							;max count bit, use input as enable of counter
=							;don't prescale, use internal clocking, always
=							;reg A ( no reg B for TMR0), do continuously
=
=			;8 Mhz divisors for common baud rates
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   3


=
=  0006 		REGA_9600	EQU	6
=  0007 		REGB_9600	EQU	7	;Divisor for 9600 BAUD
=  000D 		REGA_4800	EQU	13
=  000D 		REGB_4800	EQU	13	;Divisor for 4800 BAUD
=  001A 		REGA_2400	EQU	26
=  001A 		REGB_2400	EQU	26	;Divisor for 2400 BAUD
=  0034 		REGA_1200	EQU	52
=  0034 		REGB_1200	EQU	52	;Divisor for 1200 BAUD
=  00D0 		REGA_300	EQU	208
=  00D1 		REGB_300	EQU	209	;Divisor for 300 BAUD
=  0238 		REGA_110	EQU	568	
=  0238 		REGB_110	EQU	568	;Divisor for 300 BAUD
=
=			;8 Mhz divisor for 10 Ms interrupt rate for TMR2
=
=  4E20 		TMR2_REGA_DIVISOR	EQU	20000
=
=			;Interrupt controller equates. The interrupt controller is used in master
=			;mode. Only timer 2 is allowed to generate interrupts. On initialization
=			;the console interrupt is enabled.
=
=  FF22 		EOI_REG 		EQU	0FF22H	;End of interrupt register
=  FF24 		POLL_REG		EQU	0FF24H	;Poll register to detrermine who's
=								;requesting. Reading will acknoledge
=								;the interrupt.
=  FF26 		POLL_STATUS_REG 	EQU	0FF26H	;Gets the interrupt status with out
=								;acking the interrupt.
=  FF28 		MASK_REG		EQU	0FF28H	;Can mask out any interrupt
=  FF2A 		PRIORITY_MASK_REG	EQU	0FF2AH	;prevents interrupts of lower priority
=								;than that set in this register from
=								;interrupting the processor
=  FF2C 		IN_SERVICE_REG		EQU	0FF2CH	;Bits correspond to interrupts
=								;which are being serviced
=  FF2E 		INTERRUPT_REQ_REG	EQU	0FF2EH	;Bits correspond to interrupts
=								;requesting service
=  FF30 		INTERRUPT_CTRL_STATUS	EQU	0FF30H	;Status of timer interrups and DMA
=								;disable bit
=  FF32 		PIC_TMR_CTRL_REG	EQU	0FF32H	;
=  FF34 		PIC_DMA0_CTRL_REG	EQU	0FF34H
=  FF36 		PIC_DMA1_CTRL_REG	EQU	0FF36H
=  FF38 		INT0_CTRL_REG		EQU	0FF38H
=  FF3A 		INT1_CTRL_REG		EQU	0FF3AH
=  FF3C 		INT2_CTRL_REG		EQU	0FF3CH
=  FF3E 		INT3_CTRL_REG		EQU	0FF3EH
=
=			;
=			; I/O device equates for THUNDER 186
=			;
=  0080 		BASE			EQU	80H
=			; Serial port equates
=
=  0080 		SER_PORT1_DATA		EQU	BASE+0
=  0082 		SER_PORT1_COMMAND	EQU	BASE+2
=  0082 		SER_PORT1_STATUS	EQU	BASE+2
=  0001 		TXRDY			EQU	1
=  0002 		RXRDY			EQU	2
=
=  00C0 		SER_PORT2_DATA		EQU	BASE+40H
=  00C2 		SER_PORT2_COMMAND	EQU	BASE+42H
=  00C2 		SER_PORT2_STATUS	EQU	BASE+42H
=
=			;8251A Commands
=
=  0040 		USART_RESET		EQU	40H
=  00CE 		USART_MODE		EQU	11001110B ;8 BIT, 2 STOP, X16 MODE
=  0037 		USART_INST		EQU	00110111B ;ENABLE RX AND TX ASSERT DTR, RTS
=
=			; Parallel port equates
=
=  00D0 		PORTA			EQU	BASE+50H
=  00D2 		PORTB			EQU	BASE+52H
=  00D4 		PORTC			EQU	BASE+54H
=  00D2 		SWITCH_PORT		EQU	PORTB
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   4


=  000F 		SWITCH_MASK		EQU	00001111B	;ONLY BITS 0 TO 3
=  00D6 		PAR_CTRL		EQU	BASE+56H
=  0082 		PAR_PORT_MODE		EQU	82H		;A AND C OUT, B IN
=  000F 		PORTC_INITIAL		EQU	00001111B	;INITIAL SETTING FOR PORTC
=
=			;*********************	PORT C BIT ASSIGNMENTS **************************
=			;BIT 0 - PRINTER STROBE, ACTIVE LOW
=			;BIT 1 - AUTO FEED PRINTER INPUT, ACTIVE LOW
=			;BIT 2 - PRINTER INIT INPUT, ACTIVE LOW
=			;BIT 3 - PRINTER SELECT INPUT, ACTIVE LOW
=			;BIT 4 - PRINTER INTERRUPT CLEAR BIT, ACTIVE LOW
=			;BIT 5 - FLOPPY DRIVE READY SIGNAL. This signal output is used to assert
=			;	 the READY status of the FDC for drives that do not have ready status
=			;	 signals
=			;BIT 6 - FDC TERMINAL COUNT INPUT. Used to terminate a command in progress.
=			;BIT 7 - FDC DRIVE TYPE SELECT. When set high sellects 8" dirves and when
=                       ;       set low sellects 5 1/4" drives.
=			;************************************************************************
=
=			; Floppy disk equates
=
=  0092 		FDC_DATA		EQU	BASE+12H
=  0092 		FDC_COMMAND		EQU	BASE+12H
=  0090 		FDC_STATUS		EQU	BASE+10H
=  0092 		FDC_RESULT		EQU	BASE+12H
=  00A0 		FDC_DMA 		EQU	BASE+20H
=
=			;


   00FF 		TRUE		EQU	0FFH
   0000 		FALSE		EQU	0
   0082 		STAT		EQU	SER_PORT1_STATUS ;CONSOLE STATUS PORT
   0080 		DATA		EQU	SER_PORT1_DATA	;CONSOLE DATA PORT
   0080 		SER1DATA	EQU	DATA		;ALTERNATE EQUATE FOR CONSLOE
   0082 		SER1CTL 	EQU	STAT
   0082 		SER1STATUS	EQU	STAT


   0082 		USRTCMND	EQU	SER_PORT1_COMMAND
   0002 		DAV		EQU	RXRDY		;UART DATA AVAILABLE BIT
   0001 		TBMT		EQU	TXRDY		;UART transmitter ready bit
   0050 		BUFLEN		EQU	80		;Maximum length of line input buffer
   000A 		BPMAX		EQU	10		;Maximum number of breakpoints
   0014 		BPLEN		EQU	BPMAX+BPMAX	;Length of breakpoint table
   000E 		REGTABLEN	EQU	14		;Number of registers
   002A 		PROMPT		EQU	'*'
   0040 		CAN		EQU	'@'

			;RAM area.

 0400			BRKCNT		RW	1		;Number of breakpoints
 0402			TCOUNT		RW	1		;Number of steps to trace
 0404			BPTAB		RB	BPLEN		;Breakpoint table
 0418			LINEBUF 	RB	BUFLEN+1	;Line input buffer
 0469					RW	25		;Working stack area
   049B 		STACK		EQU	$

			;Register save area

 049B			AXSAVE	RW	1
 049D			BXSAVE	RW	1
 049F			CXSAVE	RW	1
 04A1			DXSAVE	RW	1
 04A3			SPSAVE	RW	1
 04A5			BPSAVE	RW	1
 04A7			SISAVE	RW	1
 04A9			DISAVE	RW	1
 04AB			DSSAVE	RW	1
 04AD			ESSAVE	RW	1
   04AF 		RSTACK	EQU	$
 04AF			SSSAVE	RW	1
 04B1			CSSAVE	RW	1
 04B3			IPSAVE	RW	1
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   5


 04B5			FSAVE	RW	1
   04B7 		IOPB	EQU	$
 04B7			CMND		RB	1
 04B8			UNIT		RB	1
 04B9			CYL		RB	1
 04BA			HEAD		RB	1
 04BB			SECT		RB	1
   04BB 		SECTOR		EQU	SECT
 04BC			NBYTES		RB	1
 04BD			EOT		RB	1
 04BE			GPL		RB	1
 04BF			DTL		RB	1
 04C0			RETRY		RB	1
 04C1			DMAOFF		RW	1
 04C3			DMASEG		RW	1
 04C5			RTT		RW	2
 04C9			READFLAG	RB	1
 04CA			TRANSFER	RW	1
 04CC			DISKTABLE	RB	4
 04D0			DONTPRNT	RB	1
   04D1 		RSLTS		EQU	$
 04D1			ST0		RB	1
 04D2			ST1		RB	1
 04D3			ST2		RB	1
 04D4					RB	6
 04DA			MINI		RB	1
 04DB			TRACK		RB	1
 04DC			DBLSDD		RB	1
 04DD			RECORD		RW	1		;BEGINING RECORD TO TRANSFER

 04DF			FIRSTSEG	RW	1
 04E1			NUMSEGS 	RW	1
 04E3			LOOPCNT 	RW	1
 04E5			ERRORS		RW	1
 04E7			TIMES		RW	1

			;Start of Monitor code

   FE00 			CSEG	0FE00H
				ORG	0
			;Linkage to internal routines for reading and writing diskettes, console
			;output and message output.
 0000 E80E0B	   0B11 DWRITE: CALL	WRITEDSK1
 0003 CB			RETF
 0004 E8160B	   0B1D DREAD:	CALL	READ1
 0007 CB			RETF
 0008 E86402	   026F CIN:	CALL	IN
 000B CB			RETF
 000C E8D102	   02E0 COUT:	CALL	OUT
 000F CB			RETF
 0010 E86902	   027C CMSG:	CALL	PMSG
 0013 CB			RETF
 0014 CF		INTRET: IRET			;DUMMY RETURN FOR EXCEPTIONS OF 80186

			;One-time initialization
			INIT:				;Place where initialization starts
 0015 FC			CLD
 0016 33C0			XOR	AX,AX		;GET 0
 0018 8BD8			MOV	BX,AX
			MEMINITLOOP:
 001A B90080			MOV	CX,8000H	;64K WORDS
 001D 8BF8			MOV	DI,AX		;SET SEG REG'S
 001F 8EC3			MOV	ES,BX
 0021 F3AB			REP	STOSW		;FILL WITH 0'S
 0023 81C30010			ADD	BX,1000H
 0027 81FB0040			CMP	BX,4000H	;ONLY FILL FIRST 1/4 MEG (ON BOARD MEM ONLY)
 002B 75ED	   001A 	JNE	MEMINITLOOP
			INITBAUD:
 002D E4D2			IN	AL,SWITCH_PORT	;GET THE INITIAL BAUD RATE FROM SWITCHES
 002F 2403			AND	AL,03H		;SAVE ONLY FIRST TWO SWITCHES
 0031 B400			MOV	AH,0
 0033 D1E0			SHL	AX,1		;SWITCHES TIMES 4
 0035 D1E0			SHL	AX,1
 0037 BB5300			MOV	BX,offset BAUDTABLE
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   6


 003A 03D8			ADD	BX,AX		;OFFSET INTO BAUD RATE TABLE
 003C 2E8B870000		MOV	AX,CS:[BX]
 0041 BA5AFF			MOV	DX,MAX_CNT_REGA_TMR1
 0044 EF			OUT	DX,AX
 0045 BA5CFF			MOV	DX,MAX_CNT_REGB_TMR1
 0048 83C302			ADD	BX,2
 004B 2E8B870000		MOV	AX,CS:[BX]
 0050 EF			OUT	DX,AX
 0051 EB10	   0063 	JMPS	PONTEST
			BAUDTABLE:
 0053 0600			DW	REGA_9600	;9600
 0055 0700			DW	REGB_9600		
 0057 3400			DW	REGA_1200	;1200
 0059 3400			DW	REGB_1200
 005B D000			DW	REGA_300	;300
 005D D100			DW	REGB_300
 005F 3802			DW	REGA_110	;110
 0061 3802			DW	REGB_110

			PONTEST:			;POWER ON TEST OF FIRST 1K OF RAM
 0063 33C0			XOR	AX,AX
 0065 8ED0			MOV	SS,AX
 0067 8ED8			MOV	DS,AX
 0069 8EC0			MOV	ES,AX
 006B BC9B04			MOV	SP,offset STACK ;INIT STACK POINTER FOR LATER
 006E B8AA55			MOV	AX,055AAH	;FIRST MEMORY TEST VALUE
 0071 BF0000			MOV	DI,0		;OFFSET TO START TESTING AT
 0074 B90004			MOV	CX,1024 	;NUMBER OF WORDS IN FIRST 2K BYTES
 0077 F3AB			REP	STOSW		;FILL FIRST 2K
 0079 BF0000			MOV	DI,0		;RE-ESTABLISH POINTER AND LOOP COUNT
 007C B90004			MOV	CX,1024
 007F F3AF			REPE	SCASW		;CHECK TO SEE IF DATA IS CORRECT
 0081 7518	   009B 	JNE	INITERROR	;IF NOT REPORT IS ON CONSOLE AT 9600 BAUD
 0083 B855AA			MOV	AX,0AA55H	;COMPLEMENT OF PREVIOS VALUE
 0086 BF0000			MOV	DI,0		;SET UP POINTER AND REP COUNT
 0089 B90004			MOV	CX,1024
 008C F3AB			REPE	STOSW		;FILL 1ST 2K
 008E BF0000			MOV	DI,0
 0091 B90004			MOV	CX,1024
 0094 F3AF			REPE	SCASW		;CHECK AGAIN
 0096 BABF00			MOV	DX,offset ADR_TEST ;POINT TO GO TO AFTER MESSAGE
 0099 7405	   00A0 	JE	INITOK		;MEMORY OK IF LAST COMPARE OK
			INITERROR:
 009B BE5E01			MOV	SI,offset MEM_FAIL_MSG1 ;OTHERWISE REPORT MEMORY FAILURE
 009E EB03	   00A3 	JMPS	PON_PRNT	;REPORT ERROR
			INITOK: 
 00A0 BEC401			MOV	SI,offset MEM_OK_MSG
			PON_PRNT:
 00A3 E482			IN	AL,STAT 
 00A5 A801			TEST	AL,TBMT 	;OK TO SEND ?
 00A7 74FA	   00A3 	JZ	PON_PRNT	;IF NOT A ONE WAIT UNTIL IT IS
 00A9 2E8A840000		MOV	AL,CS:[SI]	;GET CHARACTER FROM MESSAGE
 00AE E680			OUT	DATA,AL 	;SEND IT
 00B0 46			INC	SI		;POINT TO NEXT CHARACTER
 00B1 84C0			TEST	AL,AL		;LAST CHARACTER?
 00B3 75EE	   00A3 	JNZ	PON_PRNT
 00B5 FFE2			JMP	DX		;RETURN (KIND OF)

			ADR_TEST_FAIL:
 00B7 BE8701			MOV	SI,offset MEM_ADR_FAIL
 00BA BAFF00			MOV	DX,offset INIT2 ;CONTINUE EXECUTION ANYWAY
 00BD EBE4	   00A3 	JMPS	PON_PRNT

			ADR_TEST:
			;TEST MEMORY FOR ADDRESS TYPE FAILURES: INTERNAL RAM SHORTS, BOARD SHORTS
			;ETC. FIRST WRITE THE ADDRESS AT THE WORD ADDRESS AND THEN VERIFY THE
			;CORRECT ADDRESS IS PRESENT. THEN WRITE THE BYTE ADDRESS IN MEMORY AND
			;VERIFY CORRECT. THIS TESTS BOTH BYTE AND WORD WRITE WRITE LOGIC.
 00BF BE0000			MOV	SI,0		;START WITH LOCATION 0
 00C2 B90004			MOV	CX,400H 	;DO FIRST 2K BYTES OF MEMORY
			ADR_TEST_LOOP1:
 00C5 8934			MOV	[SI],SI 	;WRITE THE ADDRESS AT ADDRESS
 00C7 46			INC	SI
 00C8 46			INC	SI		;DOUBLE INC TO NEXT WORD
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   7


 00C9 E2FA	   00C5 	LOOP	ADR_TEST_LOOP1	;DO ALL 2K
 00CB BE0000			MOV	SI,0		;RE INIT FOR READ BACK
 00CE B90004			MOV	CX,400H
			ADR_TEST_LOOP2:
 00D1 3934			CMP	[SI],SI 	;CHECK THE MEMORY LOCATION
 00D3 75E2	   00B7 	JNE	ADR_TEST_FAIL	;IF NOT THE SAME MEMORY FAILURE
 00D5 46			INC	SI
 00D6 46			INC	SI
 00D7 E2F8	   00D1 	LOOP	ADR_TEST_LOOP2	;DO UNTILL ALL 2K DONE
 00D9 BF0000			MOV	DI,0		;NOW INIT FOR BYTE ADDRESS TEST
 00DC B90008			MOV	CX,800H 	;2K BYTES
 00DF B000			MOV	AL,0		;INITIAL VALUE
			ADR_TEST_LOOP3: 
 00E1 AA			STOSB			;PUT IT IN MEMORY
 00E2 FEC0			INC	AL		;NEXT VALUE
 00E4 E2FB	   00E1 	LOOP	ADR_TEST_LOOP3	;DO FULL 2K
 00E6 BE0000			MOV	SI,0		;NOW RE-INIT FOR READ VERIFY
 00E9 B90008			MOV	CX,800H 	;2K AGAIN
 00EC B400			MOV	AH,0		;INITIAL VALUE OF TEST BYTE
			ADR_TEST_LOOP4:
 00EE AC			LODSB			;GET MEMORY VALUE
 00EF 3AC4			CMP	AL,AH
 00F1 75C4	   00B7 	JNE	ADR_TEST_FAIL
 00F3 FEC4			INC	AH		;NEXT TEST VALUE
 00F5 E2F7	   00EE 	LOOP	ADR_TEST_LOOP4	;DO ALL
 00F7 BAFF00			MOV	DX,offset INIT2
 00FA BEA701			MOV	SI,offset MEM_ADR_OK
 00FD EBA4	   00A3 	JMPS	PON_PRNT

			INIT2:
			;IF NO ERROR OR AFTER ERROR REPORTED
			;EXECUTION CONTINUES
 00FF BF0000			MOV	DI,0			;NOW ZERO FIRST 2K
 0102 B90004			MOV	CX,1024
 0105 B80000			MOV	AX,0
 0108 F3AB			REP	STOSW
 010A C70600001400		MOV	INT0IP,offset INTRET
 0110 8C0E0200			MOV	INT0CS,CS		;SET FIRTS 17 INTERRUPT VECTORS FOR NO EFFECT
 0114 BE0000			MOV	SI,0			; EFFECT, JUST DOES AN IRET
 0117 BF0400			MOV	DI,4
 011A B92000			MOV	CX,16*2 		;NUMBER OF ADDITIONAL INTERRUPT VECTORS TO SET
 011D F3A5			REP	MOVSW
 011F 800EB60402		OR	byte Ptr FSAVE+1,2	;Enable interrupts in REG save area
 0124 B90400			MOV	CX,4
 0127 B85000			MOV	AX,50H
 012A BFAB04			MOV	DI,offset DSSAVE
 012D F3AB			REP	STOSW			;Set segment reg. images to 40H
 012F C706A3040004		MOV	SPSAVE,400H
 0135 C706AF040000		MOV	SSSAVE,0

			;Initnialize the 8272
 013B B003			MOV	AL,3		;SPECIFY COMMAND
 013D E8070D	   0E47 	CALL	OUTFDC
 0140 B08F			MOV	AL,08FH 	;8MS STEP 240MS UNLOAD TIME
 0142 E8020D	   0E47 	CALL	OUTFDC
 0145 B080			MOV	AL,80H		;LOAD + SETTLE TIME=128 ms
 0147 E8FD0C	   0E47 	CALL	OUTFDC
			;set up console interrupt
 014A C7063C00640A		MOV	INT_15_OFF,offset INT
 0150 8C0E3E00			MOV	INT_15_SEG,CS
 0154 BA3EFF			MOV	DX,INT3_CTRL_REG	;TURN ON CONSOLE INTERRUPT
 0157 B81700			MOV	AX,00010111B		;PRIORITY 7 LEVEL TRIGERED
 015A EF			OUT	DX,AX
 015B E98100	   01DF 	JMP	MONITOR 	;GO CHECK THE BAUDRATE

			MEM_FAIL_MSG1:
 015E 0D0A4D656D6F		DB	CR,LF,'Memory failure or memory not present',CR,LF,0
      727920666169
