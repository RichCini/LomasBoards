                        CONVERT:
                        ;CONVERT DECIMAL QTY TO HEX AND DISPLAY.
 083C B90400                    MOV     CX,4            ;FOUR DIGIT NUMBER MAX
 083F E826FC       0468         CALL    GETHEX
 0842 BB0F00                    MOV     BX,0FH          ;MASK FOR LOW NIBLE
 0845 23DA                      AND     BX,DX           ;SAVE FIRTS NIBLE IN BX
 0847 B80F00                    MOV     AX,0FH          ;MASK FOR NEXT NIBLE
 084A B104                      MOV     CL,4            ;SHIFT VALUE
 084C D3EA                      SHR     DX,CL           ;SHIFT NEXT NIBLE RIGHT
 084E 52                        PUSH    DX              ;SAVE THE NEW VALUE
 084F 23C2                      AND     AX,DX           ;SAVE NEXT NIBLE IN AX
 0851 BA0A00                    MOV     DX,10
 0854 F7E2                      MUL     DX              ;MULTIPLY TENS DIGIT BY TEN
 0856 03D8                      ADD     BX,AX           ;PUT INTO CONVERTED VALUE
 0858 5A                        POP     DX              ;GET DX BACK
 0859 D3EA                      SHR     DX,CL           ;GET NEXT NIBLE
 085B 52                        PUSH    DX              ;SAVE NEW DX
 085C 81E20F00                  AND     DX,0FH          ;SAVE ONLY 100'S DIGIT
 0860 8BC2                      MOV     AX,DX
 0862 BA6400                    MOV     DX,100
 0865 F7E2                      MUL     DX
 0867 03D8                      ADD     BX,AX
 0869 5A                        POP     DX
 086A D3EA                      SHR     DX,CL
 086C 81E20F00                  AND     DX,0FH
 0870 8BC2                      MOV     AX,DX
 0872 BAE803                    MOV     DX,1000
 0875 F7E2                      MUL     DX
 0877 03D8                      ADD     BX,AX
 0879 8BD3                      MOV     DX,BX           ;PUT CONVERTED VALUE IN DX
 087B E846FA       02C4         CALL    OUT16
 087E E8E0F9       0261         CALL    CRLF
 0881 C3                        RET
                        HEXARITH:
