 0A61 E9C8FE       092C         JMP     EXIT

                        ;Console input interrupt handler. Used to interrupt commands
                        ;or programs under execution (if they have interrupts
                        ;enabled). Control-S causes a loop which waits for any other
                        ;character to be typed. Control-C causes abort to command
                        ;mode. All other characters are ignored.

                        INT:
 0A64 50                        PUSH    AX              ;Don't destroy accumulator
 0A65 52                        PUSH    DX              ;Save this one too
 0A66 BA22FF                    MOV     DX,EOI_REG
 0A69 B80080                    MOV     AX,8000H        ;nonspecific eoi
 0A6C EF                        OUT     DX,AX
 0A6D 5A                        POP     DX              ;not used again now
 0A6E E480                      IN      AL,DATA         ;Get interrupting character
 0A70 247F                      AND     AL,7FH          ;ASCII has only 7 bits
 0A72 3C13                      CMP     AL,'S'-'@'      ;Check for Control-S
 0A74 7503         0A79         JNZ     NOSTOP
 0A76 E8F6F7       026F         CALL    IN              ;Wait for continue character
                        NOSTOP:
 0A79 3C03                      CMP     AL,'C'-'@'      ;Check for Control-C
 0A7B 7402         0A7F         JZ      BREAK
                        ;Just ignore interrupt - restore AX and return
 0A7D 58                        POP     AX
 0A7E CF                        IRET
                        BREAK:
 0A7F E8DFF7       0261         CALL    CRLF
 0A82 E96FF7       01F4         JMP     COMMAND

