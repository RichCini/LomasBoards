			MEM_ADR_OK:
 01A7 0D0A4D656D6F		DB	CR,LF,'Memory address test pass',cr,lf,0
      727920616464
      726573732074
      657374207061
      73730D0A00
			MEM_OK_MSG:
 01C4 0D0A506F7765		DB	CR,LF,'Power on test complete',cr,lf,0
      72206F6E2074
      65737420636F
      6D706C657465
      0D0A00

			;Initialization complete, including baud rate.

			MONITOR:
			; Do auto boot if sense switch 0 is on.
 01DF BF1804			MOV	DI,offset LINEBUF
 01E2 C6050D			MOV	byte ptr [DI],13  ;No breakpoints after boot
 01E5 E4D2			IN	AL,SWITCH_PORT	;GET FDC EXTERNAL PORT
 01E7 A804			TEST	AL,04H		;IS SWITCH 3 ON?
 01E9 7503	   01EE 	JNZ	DOMON		;GO TO MONITOR IF IT ISNT ON
 01EB E98B05	   0779 	JMP	BOOT
			DOMON:
 01EE BEE10A			MOV	SI,offset HEADER
 01F1 E89500	   0289 	CALL	PRINTMES
			COMMAND:
			;Re-establish initial conditions
 01F4 FC			CLD
 01F5 33C0			XOR	AX,AX
 01F7 8ED8			MOV	DS,AX
 01F9 8EC0			MOV	ES,AX
 01FB BC9B04			MOV	SP,offset STACK
 01FE C7063C00640A		MOV	INT_15_OFF,offset INT ;SET USART INTERRUPT VECTOR
 0204 8C0E3E00			MOV	INT_15_SEG,CS
 0208 B02A			MOV	AL,PROMPT
 020A E8D300	   02E0 	CALL	OUT
 020D E81E00	   022E 	CALL	INBUF		;Get command line
			;From now and throughout command line processing, DI points
			;to next character in command line to be processed.
 0210 E88A00	   029D 	CALL	SCANB		;Scan off leading blanks
 0213 74DF	   01F4 	JZ	COMMAND 	;Null command?
 0215 8A05			MOV	AL,[DI] 	;AL=first non-blank character
			;Prepare command letter for table lookup
 0217 2C42			SUB	AL,'B'		;Low end range check
 0219 7210	   022B 	JC	ERR1
 021B 3C16			CMP	AL,'W'+1-'B'	;UPPER END RANGE CHECK
 021D 730C	   022B 	JNC	ERR1
 021F 47			INC	DI
 0220 D0E0			SHL	AL,1		;Times two
 0222 98			CBW			;Now a 16-bit quantity
 0223 93			XCHG	BX,AX		;In BX we can address with it
 0224 2EFF97F502		CALL	CS:word ptr COMTAB[BX]	;Execute command
 0229 EBC9	   01F4 	JMPS	COMMAND 	;Get next command
 022B E9B902	   04E7 ERR1:	JMP	ERROR

			;Get input line

			INBUF:
 022E BF1804			MOV	DI,offset LINEBUF ;Next empty buffer location
 0231 33C9			XOR	CX,CX		;Character count
			GETCH:
 0233 E83900	   026F 	CALL	IN		;Get input character
 0236 3C20			CMP	AL,20H		;Check for control characters
 0238 721B	   0255 	JC	CONTROL
 023A 3C7F			CMP	AL,7FH		;RUBOUT is a backspace
 023C 740E	   024C 	JZ	BACKSP
 023E E89F00	   02E0 	CALL	OUT		;Echo character
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE   9


 0241 3C40			CMP	AL,CAN		;Cancel line?
 0243 7425	   026A 	JZ	KILL
 0245 AA			STOSB			;Put in input buffer
 0246 41			INC	CX		;Bump character count
 0247 83F950			CMP	CX,BUFLEN	;Buffer full?
 024A 7EE7	   0233 	JLE	GETCH		;Drop in to backspace if full
			BACKSP:
 024C E3E5	   0233 	JCXZ	GETCH		;Can't backspace over nothing
 024E 4F			DEC	DI		;Drop pointer
 024F 49			DEC	CX		;and character count
 0250 E83300	   0286 	CALL	BACKUP		;Send physical backspace
 0253 EBDE	   0233 	JMPS	GETCH		;Get next char.
			CONTROL:
 0255 3C08			CMP	AL,8		;Check for backspace
 0257 74F3	   024C 	JZ	BACKSP
 0259 3C0D			CMP	AL,13		;Check for carriage return
 025B 75D6	   0233 	JNZ	GETCH		;Ignore all other control char.
 025D AA			STOSB			;Put the car. ret. in buffer
 025E BF1804			MOV	DI,offset LINEBUF ;Set up DI for command processing

			;Output CR/LF sequence

			CRLF:
 0261 B00D			MOV	AL,13
 0263 E87A00	   02E0 	CALL	OUT
 0266 B00A			MOV	AL,10
 0268 EB76	   02E0 	JMPS	OUT

			;Cancel input line

			KILL:
 026A E8F4FF	   0261 	CALL	CRLF
 026D EB85	   01F4 	JMPS	COMMAND

			;Character input routine

			IN:
 026F FA			CLI			;Poll, don't interrupt
 0270 E482			IN	AL,STAT
 0272 A802			TEST	AL,DAV
 0274 74F9	   026F 	JZ	IN		;Loop until ready
 0276 E480			IN	AL,DATA
 0278 247F			AND	AL,7FH		;Only 7 bits
 027A FB			STI			;Interrupts OK now
			RET1:
 027B C3			RET

			; Print message routine for rom call
			;
			PMSG:			;DS:SI = Pointer to message
 027C AC			LODSB
 027D 84C0			TEST	AL,AL	;0 = END OF MESSAGE
 027F 74FA	   027B 	JZ	RET1
 0281 E85C00	   02E0 	CALL	OUT
 0284 EBF6	   027C 	JMPS	PMSG
				

			;Physical backspace - blank, backspace, blank

			BACKUP:
 0286 BE0D0B			MOV	SI,offset BACMES
			;Print ASCII message. Last char has bit 7 set

			PRINTMES:
 0289 2EAC			LODS	CS:AL		;Get char to print
 028B 84C0			TEST	AL,AL		;Is it a 0
 028D 74EC	   027B 	JZ	RET1		;If it is quit
 028F E84E00	   02E0 	CALL	OUT
 0292 EBF5	   0289 	JMPS	PRINTMES

			;Scan for parameters of a command

			SCANP:
 0294 E80600	   029D 	CALL	SCANB		;Get first non-blank
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  10


 0297 803D2C			CMP	byte ptr [DI],','	;One comma between params OK
 029A 750A	   02A6 	JNE	EOLCHK		;If not comma, we found param
 029C 47			INC	DI		;Skip over comma

			;Scan command line for next non-blank character

			SCANB:
 029D B020			MOV	AL,' '
 029F 51			PUSH	CX		;Don't disturb CX
 02A0 B1FF			MOV	CL,-1		;but scan as many as necessary
 02A2 F3AE			REPE	SCASB
 02A4 4F			DEC	DI		;Back up to first non-blank
 02A5 59			POP	CX
			EOLCHK:
 02A6 803D0D			CMP	byte ptr [DI],13
 02A9 C3			RET

			;Print the 5-digit hex address of SI and DS

			OUTSI:
 02AA 8CDA			MOV	DX,DS		;Put DS where we can work with it
 02AC B400			MOV	AH,0		;Will become high bits of DS
 02AE E87E00	   032F 	CALL	SHIFT4		;Shift DS four bits
 02B1 03D6			ADD	DX,SI		;Compute absolute address
 02B3 EB09	   02BE 	JMPS	OUTADD		;Finish below

			;Print 5-digit hex address of DI and ES
			;Same as OUTSI above

			OUTDI:
 02B5 8CC2			MOV	DX,ES
 02B7 B400			MOV	AH,0
 02B9 E87300	   032F 	CALL	SHIFT4
 02BC 03D7			ADD	DX,DI
			;Finish OUTSI here too
			OUTADD:
 02BE 80D400			ADC	AH,0		;Add in carry to high bits
 02C1 E81200	   02D6 	CALL	HIDIG		;Output hex value in AH

			;Print out 16-bit value in DX in hex

			OUT16:
 02C4 8AC6			MOV	AL,DH		;High-order byte first
 02C6 E80200	   02CB 	CALL	HEX
 02C9 8AC2			MOV	AL,DL		;Then low-order byte

			;Output byte in AL as two hex digits

			HEX:
 02CB 8AE0			MOV	AH,AL		;Save for second digit
			;Shift high digit into low 4 bits
 02CD 51			PUSH	CX
 02CE B104			MOV	CL,4
 02D0 D2E8			SHR	AL,CL
 02D2 59			POP	CX

 02D3 E80200	   02D8 	CALL	DIGIT		;Output first digit
			HIDIG:
 02D6 8AC4			MOV	AL,AH		;Now do digit saved in AH
			DIGIT:
 02D8 240F			AND	AL,0FH		;Mask to 4 bits
			;Trick 6-byte hex conversion works on 8086 too.
 02DA 0490			ADD	AL,90H
 02DC 27			DAA
 02DD 1440			ADC	AL,40H
 02DF 27			DAA

			;Console output of character in AL

			OUT:
 02E0 50			PUSH	AX		;Character to output on stack
			OUT1:
 02E1 E482			IN	AL,STAT
 02E3 A801			TEST	AL,TBMT
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  11


 02E5 74FA	   02E1 	JZ	OUT1		;Wait until ready
 02E7 58			POP	AX
 02E8 E680			OUT	DATA,AL 
 02EA C3			RET

			;Output one space

			BLANK:
 02EB B020			MOV	AL,' '
 02ED EBF1	   02E0 	JMPS	OUT

			;Output the number of blanks in CX

			TAB:
 02EF E8F9FF	   02EB 	CALL	BLANK
 02F2 E2FB	   02EF 	LOOP	TAB
 02F4 C3			RET

			;Command Table. Command letter indexes into table to get
			;address of command. PERR prints error for no such command.

			COMTAB:
 02F5 7907			DW	BOOT		;B
 02F7 3C08			DW	CONVERT 	;C-CONVERT DECIMAL TO HEX
 02F9 8B03			DW	DUMP		;D
 02FB 0605			DW	ENTER		;E
 02FD 1504			DW	FILL		;F
 02FF 130A			DW	GO		;G
 0301 8208			DW	HEXARITH	;H-HEX ARITHMETIC +,-,*,/
 0303 F509			DW	INPUT		;I
 0305 E604			DW	PERR		;J
 0307 E604			DW	PERR		;K
 0309 E406			DW	LOAD		;L- LOAD SECTORS FROM DISK
 030B E803			DW	MOVE		;M
 030D E604			DW	PERR		;N
 030F 020A			DW	OUTPUT		;O
 0311 E604			DW	PERR		;P
 0313 E604			DW	PERR		;Q
 0315 A705			DW	REG		;R
 0317 3804			DW	SEARCH		;S
 0319 0909			DW	TRACE		;T
 031B E604			DW	PERR		;U-ERROR
 031D F70E			DW	VTEST		;V-MEMORY TESTS
 031F FA06			DW	WRITE		;W-WRITE RECORDS TO DISK

			;Given 20-bit address in AH:DX, breaks it down to a segment
			;number in AX and a displacement in DX. Displacement is 
			;always zero except for least significant 4 bits.

			GETSEG:
 0321 8AC2			MOV	AL,DL
 0323 240F			AND	AL,0FH		;AL has least significant 4 bits
 0325 E80700	   032F 	CALL	SHIFT4		;4-bit left shift of AH:DX
 0328 8AD0			MOV	DL,AL		;Restore lowest 4 bits
 032A 8AC6			MOV	AL,DH		;Low byte of segment number
 032C 32F6			XOR	DH,DH		;Zero high byte of displacement
 032E C3			RET

			;Shift AH:DX left 4 bits

			SHIFT4:
 032F D1E2			SHL	DX,1
 0331 D0D4			RCL	AH,1	;1
 0333 D1E2			SHL	DX,1
 0335 D0D4			RCL	AH,1	;2
 0337 D1E2			SHL	DX,1
 0339 D0D4			RCL	AH,1	;3
 033B D1E2			SHL	DX,1
 033D D0D4			RCL	AH,1	;4
 033F C3		RET2:	RET

			;RANGE - Looks for parameters defining an address range.
			;The first parameter is a hex number of 5 or less digits
			;which specifies the starting address. The second parameter
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  12


			;may specify the ending address, or it may be preceded by
			;"L" and specify a length (4 digits max), or it may be
			;omitted and a length of 128 bytes is assumed. Returns with
			;segment no. in AX and displacement (0-F) in DX.

			RANGE:
 0340 B90500			MOV	CX,5		;5 digits max
 0343 E82201	   0468 	CALL	GETHEX		;Get hex number
 0346 50			PUSH	AX		;Save high 4 bits
 0347 52			PUSH	DX		;Save low 16 bits
 0348 E849FF	   0294 	CALL	SCANP		;Get to next parameter
 034B 803D4C			CMP	byte ptr [DI],'L' ;Length indicator?
 034E 741C	   036C 	JE	GETLEN
 0350 BA8000			MOV	DX,128		;Default length
 0353 E83001	   0486 	CALL	HEXIN		;Second parameter present?
 0356 721B	   0373 	JC	RNGRET		;If not, use default
 0358 B90500			MOV	CX,5		;5 hex digits
 035B E80A01	   0468 	CALL	GETHEX		;Get ending address
 035E 8BCA			MOV	CX,DX		;Low 16 bits of ending addr.
 0360 5A			POP	DX		;Low 16 bits of starting addr.
 0361 5B			POP	BX		;BH=hi 4 bits of start addr.
 0362 2BCA			SUB	CX,DX		;Compute range
 0364 1AE7			SBB	AH,BH		;Finish 20-bit subtract
 0366 751D	   0385 	JNZ	RNGERR		;Range must be less than 64K
 0368 93			XCHG	AX,BX		;AH=starting, BH=ending hi 4 bits
 0369 41			INC	CX		;Range must include ending location
 036A EB0B	   0377 	JMPS	RNGCHK		;Finish range testing and return
			GETLEN:
 036C 47			INC	DI		;Skip over "L" to length
 036D B90400			MOV	CX,4		;Length may have 4 digits
 0370 E8F500	   0468 	CALL	GETHEX		;Get the range
			RNGRET:
 0373 8BCA			MOV	CX,DX		;Length
 0375 5A			POP	DX		;Low 16 bits of starting addr.
 0376 58			POP	AX		;AH=hi 4 bits of starting addr.

			;RNGCHK verifies that the range lies entirely within one segment.
			;CX=0 means count=10000H. Range is within one segment only if
			;adding the low 4 bits of the starting address to the count is
			;<=10000H, because segments can start only on 16-byte boundaries.

			RNGCHK:
 0377 8BDA			MOV	BX,DX		;Low 16 bits of start addr.
 0379 81E30F00			AND	BX,0FH		;Low 4 bits of starting addr.
 037D E304	   0383 	JCXZ	MAXRNG		;If count=10000H then BX must be 0
 037F 03D9			ADD	BX,CX		;Must be <=10000H
 0381 739E	   0321 	JNC	GETSEG		;OK if strictly <
			MAXRNG:
			;If here because of JCXZ MAXRNG, we are testing if low 4 bits
			;(in BX) are zero. If we dropped straight in, we are testing
			;for BX+CX=10000H (=0). Either way, zero flag set means 
			;withing range.
 0383 749C	   0321 	JZ	GETSEG
			RNGERR:
 0385 B85247			MOV	AX,4700H+'R'	;RG ERROR
 0388 E91A03	   06A5 	JMP	ERR

			;Dump an area of memory in both hex and ASCII

			DUMP:
 038B E8B2FF	   0340 	CALL	RANGE		;Get range to dump
 038E 50			PUSH	AX		;Save segment
 038F E84E01	   04E0 	CALL	GETEOL		;Check for errors
 0392 1F			POP	DS		;Set segment
 0393 8BF2			MOV	SI,DX		;SI has displacement in segment
			ROW:
 0395 E812FF	   02AA 	CALL	OUTSI		;Print address at start of line
 0398 56			PUSH	SI		;Save address for ASCII dump
			BYTE0:
 0399 E84FFF	   02EB 	CALL	BLANK		;Space between bytes
			BYTE1:
 039C AC			LODSB			;Get byte to dump
 039D E82BFF	   02CB 	CALL	HEX		;and display it
 03A0 5A			POP	DX		;DX has start addr. for ASCII dump
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  13


 03A1 49			DEC	CX		;Drop loop count
 03A2 7417	   03BB 	JZ	ASCII		;If through do ASCII dump
 03A4 8BC6			MOV	AX,SI
 03A6 A80F			TEST	AL,0FH		;On 16-byte boundary?
 03A8 740C	   03B6 	JZ	ENDROW
 03AA 52			PUSH	DX		;Didn't need ASCII addr. yet
 03AB A807			TEST	AL,7		;On 8-byte boundary?
 03AD 75EA	   0399 	JNZ	BYTE0
 03AF B02D			MOV	AL,'-'		;Mark every 8 bytes
 03B1 E82CFF	   02E0 	CALL	OUT
 03B4 EBE6	   039C 	JMPS	BYTE1
			ENDROW:
 03B6 E80200	   03BB 	CALL	ASCII		;Show it in ASCII
 03B9 EBDA	   0395 	JMPS	ROW		;Loop until count is zero
			ASCII:
 03BB 51			PUSH	CX		;Save byte count
 03BC 8BC6			MOV	AX,SI		;Current dump address
 03BE 8BF2			MOV	SI,DX		;ASCII dump address
 03C0 2BC2			SUB	AX,DX		;AX=length of ASCII dump
			;Compute tab length. ASCII dump always appears on right side
			;screen regardless of how many bytes were dumped. Figure 3
			;characters for each byte dumped and subtract from 51, which
			;allows a minimum of 3 blanks after the last byte dumped.
 03C2 8BD8			MOV	BX,AX
 03C4 D1E0			SHL	AX,1		;Length times 2
 03C6 03C3			ADD	AX,BX		;Length times 3
 03C8 B93300			MOV	CX,51
 03CB 2BC8			SUB	CX,AX		;Amount to tab in CX
 03CD E81FFF	   02EF 	CALL	TAB
 03D0 8BCB			MOV	CX,BX		;ASCII dump length back in CX
			ASCDMP:
 03D2 AC			LODSB			;Get ASCII byte to dump
 03D3 247F			AND	AL,7FH		;ASCII uses 7 bits
 03D5 3C7F			CMP	AL,7FH		;Don't try to print RUBOUT
 03D7 7404	   03DD 	JZ	NOPRT
 03D9 3C20			CMP	AL,' '		;Check for control characters
 03DB 7302	   03DF 	JNC	PRIN
			NOPRT:
 03DD B02E			MOV	AL,'.'		;If unprintable character
			PRIN:
 03DF E8FEFE	   02E0 	CALL	OUT		;Print ASCII character
 03E2 E2EE	   03D2 	LOOP	ASCDMP		;CX times
 03E4 59			POP	CX		;Restore overall dump length
 03E5 E979FE	   0261 	JMP	CRLF		;Print CR/LF and return

			;Block move one area of memory to another. Overlapping moves
			;are performed correctly, i.e., so that a source byte is not
			;overwritten until after it has been moved.

			MOVE:
 03E8 E855FF	   0340 	CALL	RANGE		;Get range of source area
 03EB 51			PUSH	CX		;Save length
 03EC 50			PUSH	AX		;Save segment
 03ED 8BF2			MOV	SI,DX		;Set source displacement
 03EF B90500			MOV	CX,5		;Allow 5 digits
 03F2 E87300	   0468 	CALL	GETHEX		;in destination address
 03F5 E8E800	   04E0 	CALL	GETEOL		;Check for errors
 03F8 E826FF	   0321 	CALL	GETSEG		;Convert dest. to seg/disp
 03FB 8BFA			MOV	DI,DX		;Set dest. displacement
 03FD 5B			POP	BX		;Source segment
 03FE 8EDB			MOV	DS,BX
 0400 8EC0			MOV	ES,AX		;Destination segment
 0402 59			POP	CX		;Length
 0403 3BFE			CMP	DI,SI		;Check direction of move
 0405 1BC3			SBB	AX,BX		;Extend the CMP to 32 bits
 0407 7207	   0410 	JB	COPYLIST	;Move forward into lower mem.
			;Otherwise, move backward. Figure end of source and destination
			;areas and flip direction flag.
 0409 49			DEC	CX
 040A 03F1			ADD	SI,CX		;End of source area
 040C 03F9			ADD	DI,CX		;End of destination area
 040E FD			STD			;Reverse direction
 040F 41			INC	CX
			COPYLIST:
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  14


 0410 A4			MOVSB	;Do at least 1 - Range is 1-10000H not 0-FFFFH
 0411 49			DEC	CX
 0412 F3A4			REP	MOVSB		;Block move
 0414 C3			RET

			;Fill an area of memory with a list values. If the list
			;is bigger than the area, don't use the whole list. If the
			;list is smaller, repeat it as many times as necessary.

			FILL:
 0415 E828FF	   0340 	CALL	RANGE		;Get range to fill
 0418 51			PUSH	CX		;Save length
 0419 50			PUSH	AX		;Save segment number
 041A 52			PUSH	DX		;Save displacement
 041B E8B400	   04D2 	CALL	GLIST		;Get list of values to fill with
 041E 5F			POP	DI		;Displacement in segment
 041F 07			POP	ES		;Segment
 0420 59			POP	CX		;Length
 0421 3BD9			CMP	BX,CX		;BX is length of fill list
 0423 BE1804			MOV	SI,offset LINEBUF ;List is in line buffer
 0426 E302	   042A 	JCXZ	BIGRNG
 0428 73E6	   0410 	JAE	COPYLIST	;If list is big, copy part of it
			BIGRNG:
 042A 2BCB			SUB	CX,BX		;How much bigger is area than list?
 042C 87CB			XCHG	CX,BX		;CX=length of list
 042E 57			PUSH	DI		;Save starting addr. of area
 042F F3A4			REP	MOVSB			;Move list into area
 0431 5E			POP	SI
			;The list has been copied into the beginning of the
			;specified area of memory. SI is the first address
			;of that area, DI is the end of the copy of the list
			;plus one, which is where the list will begin to repeat.
			;All we need to do now is copy [SI] to [DI] until the
			;end of the memory area is reached. This will cause the
			;list to repeat as many times as necessary.
 0432 8BCB			MOV	CX,BX		;Length of area minus list
 0434 06			PUSH	ES		;Different index register
 0435 1F			POP	DS		;requires different segment reg.
 0436 EBD8	   0410 	JMPS	COPYLIST	;Do the block move

			;Search a specified area of memory for given list of bytes.
			;Print address of first byte of each match.

			SEARCH:
 0438 E805FF	   0340 	CALL	RANGE		;Get area to be searched
 043B 51			PUSH	CX		;Save count
 043C 50			PUSH	AX		;Save segment number
 043D 52			PUSH	DX		;Save displacement
 043E E89100	   04D2 	CALL	GLIST		;Get search list
 0441 4B			DEC	BX		;No. of bytes in list-1
 0442 5F			POP	DI		;Displacement within segment
 0443 07			POP	ES		;Segment
 0444 59			POP	CX		;Length to be searched
 0445 2BCB			SUB	CX,BX		;  minus length of list
			SCAN:
 0447 BE1804			MOV	SI,offset LINEBUF ;List kept in line buffer
 044A AC			LODSB			;Bring first byte into AL
			DOSCAN:
 044B AE			SCASB			;Search for first byte
 044C E0FD	   044B 	LOOPNE	DOSCAN		;Do at least once by using LOOP
 044E 754A	   049A 	JNZ	RET3		;Exit if not found
 0450 53			PUSH	BX		;Length of list minus 1
 0451 87D9			XCHG	BX,CX
 0453 57			PUSH	DI		;Will resume search here
 0454 F3A6			REPE	CMPSB		;Compare rest of string
 0456 8BCB			MOV	CX,BX		;Area length back in CX
 0458 5F			POP	DI		;Next search location
 0459 5B			POP	BX		;Restore list length
 045A 7508	   0464 	JNZ	TEST		;Continue search if no match
 045C 4F			DEC	DI		;Match address
 045D E855FE	   02B5 	CALL	OUTDI		;Print it
 0460 47			INC	DI		;Restore search address
 0461 E8FDFD	   0261 	CALL	CRLF
			TEST:
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  15


 0464 E334	   049A 	JCXZ	RET3
 0466 EBDF	   0447 	JMPS	SCAN		;Look for next occurrence

			;Get the next parameter, which must be a hex number.
			;CX is maximum number of digits the number may have.

			GETHEX:
 0468 E829FE	   0294 	CALL	SCANP		;Scan to next parameter
			GETHEX1:
 046B 33D2			XOR	DX,DX		;Initialize the number
 046D 8AE6			MOV	AH,DH
 046F E81400	   0486 	CALL	HEXIN		;Get a hex digit
 0472 7273	   04E7 	JC	ERROR		;Must be one valid digit
 0474 8AD0			MOV	DL,AL		;First 4 bits in position
			GETLP:
 0476 47			INC	DI		;Next char in buffer
 0477 49			DEC	CX		;Digit count
 0478 E80B00	   0486 	CALL	HEXIN		;Get another hex digit?
 047B 721D	   049A 	JC	RET3	;All done if no more digits
 047D E368	   04E7 	JCXZ	ERROR		;Too many digits?
 047F E8ADFE	   032F 	CALL	SHIFT4		;Multiply by 16
 0482 0AD0			OR	DL,AL		;and combine new digit
 0484 EBF0	   0476 	JMPS	GETLP		;Get more digits

			;Check if next character in the input buffer is a hex digit
			;and convert it to binary if it is. Carry set if not.

			HEXIN:
 0486 8A05			MOV	AL,[DI]

			;Check if AL has a hex digit and convert it to binary if it
			;is. Carry set if not.

			HEXCHK:
 0488 2C30			SUB	AL,'0'		;Kill ASCII numeric bias
 048A 720E	   049A 	JC	RET3
 048C 3C0A			CMP	AL,10
 048E F5			CMC
 048F 7309	   049A 	JNC	RET3		;OK if 0-9
 0491 2C07			SUB	AL,7		;Kill A-F bias
 0493 3C0A			CMP	AL,10
 0495 7203	   049A 	JC	RET3
 0497 3C10			CMP	AL,16
 0499 F5			CMC
 049A C3		RET3:	RET

			;Process one parameter when a list of bytes is
			;required. Carry set if parameter bad. Called by LIST

			LISTITEM:
 049B E8F6FD	   0294 	CALL	SCANP		;Scan to parameter
 049E E8E5FF	   0486 	CALL	HEXIN		;Is it in hex?
 04A1 720B	   04AE 	JC	STRINGCHK	;If not, could be a string
 04A3 B90200			MOV	CX,2		;Only 2 hex digits for bytes
 04A6 E8BFFF	   0468 	CALL	GETHEX		;Get the byte value
 04A9 8817			MOV	[BX],DL 	;Add to list
 04AB 43			INC	BX
 04AC F8		GRET:	CLC			;Parameter was OK
 04AD C3			RET
			STRINGCHK:
 04AE 8A05			MOV	AL,[DI] 	;Get first character of param
 04B0 3C27			CMP	AL,'''' 	;String?
 04B2 7406	   04BA 	JZ	STRING
 04B4 3C22			CMP	AL,'"'          ;Either quote is all right
 04B6 7402         04BA         JZ      STRING
 04B8 F9                        STC                     ;Not string, not hex - bad
 04B9 C3                        RET
                        STRING:
 04BA 8AE0                      MOV     AH,AL           ;Save for closing quote
 04BC 47                        INC     DI
                        STRNGLP:
 04BD 8A05                      MOV     AL,[DI]         ;Next char of string
 04BF 47                        INC     DI
 04C0 3C0D                      CMP     AL,13           ;Check for end of line
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84                                             PAGE  16


 04C2 7423         04E7         JZ      ERROR           ;Must find a close quote
 04C4 3AC4                      CMP     AL,AH           ;Check for close quote
 04C6 7505         04CD         JNZ     STOSTRG         ;Add new character to list
 04C8 3A25                      CMP     AH,[DI]         ;Two quotes in a row?
 04CA 75E0         04AC         JNZ     GRET            ;If not, we're done
 04CC 47                        INC     DI              ;Yes - skip second one
                        STOSTRG:
 04CD 8807                      MOV     [BX],AL         ;Put new char in list
 04CF 43                        INC     BX
 04D0 EBEB         04BD         JMPS    STRNGLP         ;Get more characters

                        ;Get a byte list for ENTER, FILL or SEARCH. Accepts any number
                        ;of 2-digit hex values or character strings in either single
                        ;(') or double (") quotes.

			GLIST:
 04D2 BB1804			MOV	BX,offset LINEBUF ;Put byte list in the line buffer
			LISTLP:
 04D5 E8C3FF	   049B 	CALL	LISTITEM	;Process a parameter
 04D8 73FB	   04D5 	JNC	LISTLP		;If OK, try for more
 04DA 81EB1804			SUB	BX,(offset LINEBUF) ;BX now has no. of bytes in list
 04DE 7407	   04E7 	JZ	ERROR		;List must not be empty

			;Make sure there is nothing more on the line except for
			;blanks and carriage return. If there is, it is an
			;unrecognized parameter and an error.

			GETEOL:
 04E0 E8BAFD	   029D 	CALL	SCANB		;Skip blanks
 04E3 7502	   04E7 	JNZ	ERROR		;Better be a RETURN
 04E5 C3			RET

			;Command error. DI has been incremented beyond the
			;command letter so it must decremented for the
			;error pointer to work.

			PERR:
 04E6 4F			DEC	DI

			;Syntax error. DI points to character in the input buffer
			;which caused error. By subtracting from start of buffer,
			;we will know how far to tab over to appear directly below
			;it on the terminal. Then print "^ Error".

			ERROR:
 04E7 81EF1704			SUB	DI,(offset LINEBUF)-1 ;How many char processed so far?
 04EB 8BCF			MOV	CX,DI		;Parameter for TAB in CX
 04ED E8FFFD	   02EF 	CALL	TAB		;Directly below bad char
 04F0 BE030B			MOV	SI,offset SYNERR ;Error message

			;Print error message and abort to command level

			PRINT:
 04F3 E893FD	   0289 	CALL	PRINTMES
 04F6 E9FBFC	   01F4 	JMP	COMMAND

			;Short form of ENTER command. A list of values from the
			;command line are put into memory without using normal
			;ENTER mode.

			GETLIST:
 04F9 E8D6FF	   04D2 	CALL	GLIST		;Get the bytes to enter
 04FC 5F			POP	DI		;Displacement within segment
 04FD 07			POP	ES		;Segment to enter into
 04FE BE1804			MOV	SI,offset LINEBUF	;List of bytes is in line buffer
 0501 8BCB			MOV	CX,BX		;Count of bytes
 0503 F3A4			REP	MOVSB			;Enter that byte list
 0505 C3			RET

			;Enter values into memory at a specified address. If the
			;line contains nothing but the address we go into "enter
                        ;mode", where the address and its current value are printed
			;and the user may change it if desired. To change, type in
			;new value in hex. Backspace works to correct errors. If
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  17


			;an illegal hex digit or too many digits are typed, the
			;bell is sounded but it is otherwise ignored. To go to the
			;next byte (with or without change), hit space bar. To
			;back up to a previous address, type "-". On
			;every 8-byte boundary a new line is started and the address
			;is printed. To terminate command, type carriage return.
			;   Alternatively, the list of bytes to be entered may be
			;included on the original command line immediately following
			;the address. This is in regular LIST format so any number
			;of hex values or strings in quotes may be entered.

			ENTER:
 0506 B90500			MOV	CX,5		;5 digits in address
 0509 E85CFF	   0468 	CALL	GETHEX		;Get ENTER address
 050C E812FE	   0321 	CALL	GETSEG		;Convert to seg/disp format
			;Adjust segment and displacement so we are in the middle
			;of the segment instead of the very bottom. This allows
			;backing up a long way.
			;	SUB	AH,8		;Adjust segment 32K down
			;	ADD	DH,80H		; and displacement 32K up
 050F 50			PUSH	AX		;Save for later
 0510 52			PUSH	DX
 0511 E889FD	   029D 	CALL	SCANB		;Any more parameters?
 0514 75E3	   04F9 	JNZ	GETLIST 	;If not end-of-line get list
 0516 5F			POP	DI		;Displacement of ENTER
 0517 07			POP	ES		;Segment
			GETROW:
 0518 E89AFD	   02B5 	CALL	OUTDI		;Print address of entry
 051B E8CDFD	   02EB 	CALL	BLANK		;Leave a space
			GETBYTE:
 051E 268A05			MOV	AL,ES:[DI]	;Get current value
 0521 E8A7FD	   02CB 	CALL	HEX		;And display it
 0524 B02E			MOV	AL,'.'
 0526 E8B7FD	   02E0 	CALL	OUT		;Prompt for new value
 0529 B90200			MOV	CX,2		;Max of 2 digits in new value
 052C BA0000			MOV	DX,0		;Intial new value
			GETDIG:
 052F E83DFD	   026F 	CALL	IN		;Get digit from user
 0532 8AE0			MOV	AH,AL		;Save
 0534 E851FF	   0488 	CALL	HEXCHK		;Hex digit?
 0537 86E0			XCHG	AH,AL		;Need original for echo
 0539 720C	   0547 	JC	NOHEX		;If not, try special command
 053B E8A2FD	   02E0 	CALL	OUT		;Echo to console
 053E 8AF2			MOV	DH,DL		;Rotate new value
 0540 8AD4			MOV	DL,AH		;And include new digit
 0542 E2EB	   052F 	LOOP	GETDIG		;At most 2 digits
			;We have two digits, so all we will accept now is a command.
			WAIT:
 0544 E828FD	   026F 	CALL	IN		;Get command character
			NOHEX:
 0547 3C08			CMP	AL,8		;Backspace
 0549 7419	   0564 	JZ	BS
 054B 3C7F			CMP	AL,7FH		;RUBOUT
 054D 7415	   0564 	JZ	BS
 054F 3C2D			CMP	AL,'-'		;Back up to previous address
 0551 744D	   05A0 	JZ	PREV
 0553 3C0D			CMP	AL,13		;All done with command?
 0555 742F	   0586 	JZ	EOL
 0557 3C20			CMP	AL,' '		;Go to next address
 0559 7431	   058C 	JZ	NEXT
			;If we got here, character was invalid. Sound bell.
 055B B007			MOV	AL,7
 055D E880FD	   02E0 	CALL	OUT
 0560 E3E2	   0544 	JCXZ	WAIT		;CX=0 means no more digits
 0562 EBCB	   052F 	JMPS	GETDIG		;Don't have 2 digits yet
			BS:
 0564 80F902			CMP	CL,2		;CX=2 means nothing typed yet
 0567 74C6	   052F 	JZ	GETDIG		;Can't back up over nothing
 0569 FEC1			INC	CL		;Accept one more character
 056B 8AD6			MOV	DL,DH		;Rotate out last digit
 056D 8AF5			MOV	DH,CH		;Zero this digit
 056F E814FD	   0286 	CALL	BACKUP		;Physical backspace
 0572 EBBB	   052F 	JMPS	GETDIG		;Get more digits

CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  18


			;If new value has been entered, convert it to binary and
			;put into memory. Always bump pointer to next location

			STORE:
 0574 80F902			CMP	CL,2		;CX=2 means nothing typed yet
 0577 740B	   0584 	JZ	NOSTO		;So no new value to store
			;Rotate DH left 4 bits to combine with DL and make a byte value
 0579 51			PUSH	CX
 057A B104			MOV	CL,4
 057C D2E6			SHL	DH,CL
 057E 59			POP	CX
 057F 0AD6			OR	DL,DH		;Hex is now converted to binary
 0581 268815			MOV	ES:[DI],DL		;Store new value
			NOSTO:
 0584 47			INC	DI		;Prepare for next location
 0585 C3			RET
			EOL:
 0586 E8EBFF	   0574 	CALL	STORE		;Enter the new value
 0589 E9D5FC	   0261 	JMP	CRLF		;CR/LF and terminate
			NEXT:
 058C E8E5FF	   0574 	CALL	STORE		;Enter new value
 058F 41			INC	CX		;Leave a space plus two for
 0590 41			INC	CX		;  each digit not entered
 0591 E85BFD	   02EF 	CALL	TAB
 0594 8BC7			MOV	AX,DI		;Next memory address
 0596 2407			AND	AL,7		;Check for 8-byte boundary
 0598 7584	   051E 	JNZ	GETBYTE 	;Take 8 per line
			NEWROW:
 059A E8C4FC	   0261 	CALL	CRLF		;Terminate line
 059D E978FF	   0518 	JMP	GETROW		;Print address on new line
			PREV:
 05A0 E8D1FF	   0574 	CALL	STORE		;Enter the new value
			;DI has been bumped to next byte. Drop it 2 to go to previous addr
 05A3 4F			DEC	DI
 05A4 4F			DEC	DI
 05A5 EBF3	   059A 	JMPS	NEWROW		;Terminate line after backing up

			;Perform register dump if no parameters or set register if a
			;register designation is a parameter.

			REG:
 05A7 E8EAFC	   0294 	CALL	SCANP
 05AA 7463	   060F 	JZ	DISPREG
 05AC 8A15			MOV	DL,[DI]
 05AE 47			INC	DI
 05AF 8A35			MOV	DH,[DI]
 05B1 80FE0D			CMP	DH,13
 05B4 7477	   062D 	JZ	FLAG			;*********
 05B6 47			INC	DI
 05B7 E826FF	   04E0 	CALL	GETEOL
 05BA 80FE20			CMP	DH,' '
 05BD 746E	   062D 	JZ	FLAG
 05BF BF850A			MOV	DI,OFFSET REGTAB
 05C2 92			XCHG	AX,DX
 05C3 0E			PUSH	CS
 05C4 07			POP	ES
 05C5 B90E00			MOV	CX,REGTABLEN
 05C8 F2AF			REPNZ	SCASW
 05CA 753D	   0609 	JNZ	BADREG
 05CC 0BC9			OR	CX,CX
 05CE 7507	   05D7 	JNZ	NOTPC
 05D0 4F			DEC	DI
 05D1 4F			DEC	DI
 05D2 2E8B85FEFF		MOV	AX,CS:[DI]-2
			NOTPC:
 05D7 E806FD	   02E0 	CALL	OUT
 05DA 8AC4			MOV	AL,AH
 05DC E801FD	   02E0 	CALL	OUT
 05DF E809FD	   02EB 	CALL	BLANK
 05E2 1E			PUSH	DS
 05E3 07			POP	ES
 05E4 8D9D14FA			LEA	BX,REGDIF-2[DI]
 05E8 8B17			MOV	DX,[BX]
 05EA E8D7FC	   02C4 	CALL	OUT16
CP/M ASM86 1.1  SOURCE: T186MON.A86   THUNDER 186 Rev 0.1 4/27/84					       PAGE  19


 05ED E871FC	   0261 	CALL	CRLF
 05F0 B03A			MOV	AL,':'
 05F2 E8EBFC	   02E0 	CALL	OUT
 05F5 E836FC	   022E 	CALL	INBUF
 05F8 E8A2FC	   029D 	CALL	SCANB
 05FB 740B	   0608 	JZ	RET4
 05FD B90400			MOV	CX,4
 0600 E868FE	   046B 	CALL	GETHEX1
 0603 E8DAFE	   04E0 	CALL	GETEOL
 0606 8917			MOV	[BX],DX
 0608 C3		RET4:	RET
			BADREG:
 0609 B84252			MOV	AX,5200H+'B'	;BR ERROR
 060C E99600	   06A5 	JMP	ERR
			DISPREG:
 060F BE850A			MOV	SI,offset REGTAB
 0612 BB9B04			MOV	BX,offset AXSAVE
 0615 B90800			MOV	CX,8
 0618 E86500	   0680 	CALL	DISPREGLINE
 061B E843FC	   0261 	CALL	CRLF
 061E B90500			MOV	CX,5
 0621 E85C00	   0680 	CALL	DISPREGLINE
